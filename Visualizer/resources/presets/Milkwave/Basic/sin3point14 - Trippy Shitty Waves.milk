warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// sin3point14 - Trippy Shitty Waves / https://www.shadertoy.com/view/3tXyRM
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  float2 fragCoord  = uv;
comp_9=`  // CONV: Center on screen, then try some aspect correction
comp_10=`  uv = (uv*2) - 1;
comp_11=`  uv *= aspect.xy;
comp_12=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_13=`  uv = float2(uv.x, -uv.y);
comp_14=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_15=`  uv += float2(0,0) + 0;
comp_16=`  uv *= float2(1,1) * 0.75;
comp_17=`
comp_18=`  //float dist = 7.0f * length(fragCoord.xy - uv.xy)/length(uv.xy);
comp_19=`  float dist = 7.0f * length(uv+1);
comp_20=`  float red = abs(cos(time - dist));
comp_21=`  // float red = 0.0f;
comp_22=`  //dist = 7.0f * length(fragCoord.xy)/length(uv.xy);
comp_23=`  dist = 7.0f * length(uv-1);
comp_24=`  float green = abs(cos(time - dist));
comp_25=`  // float green = 0.0f;
comp_26=`  fragColor = float4(red, green, 0.0f, 1.0f);
comp_27=`  ret = fragColor;
comp_28=`}
