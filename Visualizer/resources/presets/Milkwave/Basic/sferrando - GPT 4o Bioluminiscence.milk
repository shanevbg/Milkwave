warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// sferrando - GPT 4o: Bioluminiscence / https://www.shadertoy.com/view/43V3DD
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_14=`  uv += float2(0,0) + 0.5;
comp_15=`  uv *= float2(1,1) * 1;
comp_16=`
comp_17=`  // float2 uv = fragCoord/uv.xy;
comp_18=`  float time_conv = time*0.1;
comp_19=`
comp_20=`  // Background
comp_21=`  float3 color = float3(0.0, 0.05, 0.1) * (1.0 - uv.y);
comp_22=`
comp_23=`  // Fungus shape and growth pattern
comp_24=`  for (int i = 1; i < 10; i++) {
comp_25=`    float fi = float(i);
comp_26=`    float2 pos = float2(sin(fi*0.3 + time)*0.3, cos(fi*0.5 + time)*0.3);
comp_27=`    float d = length(uv - 0.5 - pos) * 1.5;
comp_28=`    color += float3(0.3, 0.5, 0.1) * exp(-d*d*10.0);
comp_29=`  }
comp_30=`
comp_31=`  // Adding bioluminescent glow effect
comp_32=`  float glow = sin(time_conv*5.0)*0.5 + 0.5;
comp_33=`  color *= float3(glow, glow*0.8, glow*0.5);
comp_34=`
comp_35=`  fragColor = float4(color, 1.0);
comp_36=`  ret = fragColor;
comp_37=`}
