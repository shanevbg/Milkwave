bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// darknoon - Gentle Rings / https://www.shadertoy.com/view/3dlfWH
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define PI 3.141596
comp_7=`
comp_8=`float3 a = float3(0.5, 0.5, 0.5);
comp_9=`float3 b = float3(0.5, 0.5, 0.5);
comp_10=`float3 c = float3(1.0, 1.0, 1.0);
comp_11=`float3 d = float3(0.00, 0.33, 0.67);
comp_12=`
comp_13=`float3 colorMap(float t) {
comp_14=`  return (a + b * cos(2. * PI * (c * t + d)));
comp_15=`}
comp_16=`
comp_17=`shader_body {
comp_18=`  float4 o = 0;
comp_19=`
comp_20=`  // CONV: Center on screen, then try some aspect correction
comp_21=`  uv = (uv*2) - 1;
comp_22=`  uv *= aspect.xy;
comp_23=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_24=`  uv = float2(uv.x, -uv.y);
comp_25=`
comp_26=`  // float2 uv = i / uv.xy;
comp_27=`  //uv -= 0.5;
comp_28=`  //uv.x *= uv.x / uv.y;
comp_29=`  float2 i = uv;
comp_30=`
comp_31=`  i.y += 2;
comp_32=`
comp_33=`  float r = length(uv);
comp_34=`  float a = atan2(uv.y, uv.x);
comp_35=`
comp_36=`  float ring = 1.5 + 0.8 * sin(PI * 0.25 * time);
comp_37=`
comp_38=`  float kr = 0.5 - 0.5 * cos(7. * PI * r);
comp_39=`  float3 kq = 0.5 - 0.5 * sin(ring*float3(30., 29.3, 28.6) * r - 6.0 * time + PI * float3(-0.05, 0.5, 1.0));
comp_40=`  float3 c = kr * (0.1 + kq * (1. - 0.5* colorMap(a / PI))) * (0.5 + 0.5 * sin(11.*a + 22.5*r));
comp_41=`
comp_42=`  // Output to screen
comp_43=`  o.rgb = lerp(float3(0.0, 0.0, 0.2), c, 0.85);
comp_44=`  ret = o;
comp_45=`}
