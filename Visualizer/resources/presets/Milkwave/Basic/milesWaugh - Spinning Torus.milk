MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// milesWaugh - Spinning Torus / https://www.shadertoy.com/view/3ljBD1
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define s sin(time)
comp_7=`#define c cos(time)
comp_8=`#define dist 4.0
comp_9=`
comp_10=`float sd(float3 pos, float d) {
comp_11=`  float3 p = pos - float3(0, 0, d);
comp_12=`  float py = p.y;
comp_13=`  p.y = p.y * c - p.z * s;
comp_14=`  p.z = p.z * c + py * s;
comp_15=`  float2 t = float2(1.0, .4);
comp_16=`  float2 q = float2(length(p.xz) - t.x, p.y);
comp_17=`  return length(q) - t.y;
comp_18=`}
comp_19=`
comp_20=`shader_body {
comp_21=`  float4 fragColor = 0;
comp_22=`  float2 fragCoord = uv;
comp_23=`  // CONV: Center on screen, then try some aspect correction
comp_24=`  uv = (uv*2) - 1;
comp_25=`  uv *= aspect.xy;
comp_26=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_27=`  uv = float2(uv.x, -uv.y);
comp_28=`  uv*=0.7;
comp_29=`
comp_30=`  float3 ambient = float3(0.4, 0.7, 1.0) / 5.0;
comp_31=`  float3 light = normalize(float3(0.8, 0.5, -0.5));
comp_32=`  // float2 uv = (fragCoord - uv.xy / 2.0) / uv.x;
comp_33=`  int iters = 0;
comp_34=`  float raylength = 0.0;
comp_35=`  float3 incoming = normalize(float3(uv, 1));
comp_36=`  float SDE = 1.0;
comp_37=`  float3 z = float3(0.0, 0.0, 0.0);
comp_38=`
comp_39=`  while (iters < 5000 && abs(raylength) < 100.0 && abs(SDE) > 0.00001) {
comp_40=`    z = raylength * incoming;
comp_41=`    SDE = sd(z, dist);
comp_42=`    raylength += SDE;
comp_43=`    iters++;
comp_44=`  }
comp_45=`
comp_46=`  float3 col = ambient;
comp_47=`  if (abs(SDE) <= 0.00001) {
comp_48=`    float3 inVec = incoming;
comp_49=`    float3 z1 = z;
comp_50=`    raylength = 0.0;
comp_51=`    incoming = normalize(float3(uv.x + 0.0001, uv.y, 1));
comp_52=`    SDE = 1.0;
comp_53=`    z = float3(0.0, 0.0, 0.0);
comp_54=`    iters = 0;
comp_55=`
comp_56=`    while (iters < 5000 && abs(raylength) < 100.0 && abs(SDE) > 0.00001) {
comp_57=`      z = raylength * incoming;
comp_58=`      SDE = sd(z, dist);
comp_59=`      raylength += SDE;
comp_60=`      iters++;
comp_61=`    }
comp_62=`
comp_63=`    float3 z2 = z;
comp_64=`    raylength = 0.0;
comp_65=`    incoming = normalize(float3(uv.x, uv.y + 0.0001, 1));
comp_66=`    SDE = 1.0;
comp_67=`    iters = 0;
comp_68=`    while (iters < 5000 && abs(raylength) < 100.0 && abs(SDE) > 0.00001) {
comp_69=`      z = raylength * incoming;
comp_70=`      SDE = sd(z, dist);
comp_71=`      raylength += SDE;
comp_72=`      iters++;
comp_73=`    }
comp_74=`
comp_75=`    float3 z3 = z;
comp_76=`    raylength = 0.0001;
comp_77=`    incoming = light;
comp_78=`    SDE = 1.0;
comp_79=`    z = float3(0.0, 0.0, 0.0);
comp_80=`    iters = 0;
comp_81=`    while (iters < 5000 && abs(raylength) < 100.0 && abs(SDE) > 0.00001) {
comp_82=`      z = raylength * incoming;
comp_83=`      SDE = sd(z + z1, dist);
comp_84=`      raylength += SDE;
comp_85=`      iters++;
comp_86=`    }
comp_87=`
comp_88=`    float3 a = z3 - z1;
comp_89=`    float3 b = z2 - z1;
comp_90=`    float3 color = float3(1.5, 1.0, 0.5);
comp_91=`    float3 normal =
comp_92=`    normalize(float3(a.y * b.z - a.z * b.y,
comp_93=`    a.z * b.x - a.x * b.z,
comp_94=`    a.x * b.y - a.y * b.x));
comp_95=`    float3 reflection = normal * 2.0 * dot(normal, inVec) - inVec;
comp_96=`    raylength = 0.01;
comp_97=`    incoming = -reflection;
comp_98=`    SDE = 1.0;
comp_99=`    z = float3(0.0, 0.0, 0.0);
comp_100=`    iters = 0;
comp_101=`    while (iters < 5000 && abs(raylength) < 100.0 && abs(SDE) > 0.00001) {
comp_102=`      z = raylength * incoming;
comp_103=`      SDE = sd(z + z1, dist);
comp_104=`      raylength += SDE;
comp_105=`      iters++;
comp_106=`    }
comp_107=`
comp_108=`    float3 diffuse =
comp_109=`    (float3(max(dot(normal, light) * 5.0, 0.0) * color) + ambient) * 0.1;
comp_110=`    float3 specular =
comp_111=`    pow(max(dot(normalize(light - inVec), normal), 0.0), 200.1)
comp_112=`    * 9.0 + ambient;
comp_113=`    if (abs(SDE) <= 0.00001)
comp_114=`    specular = ((1.0 * color) + ambient) * 0.1;
comp_115=`
comp_116=`    float fresnel = 0.05 + 0.95 * pow(1.0 + dot(inVec, normal), 5.0);
comp_117=`    col = diffuse * (1.0 - fresnel) + specular * fresnel;
comp_118=`  }
comp_119=`
comp_120=`  fragColor = float4(pow(col.x, 0.4545), pow(col.y, 0.4545), pow(col.z, 0.4545), 1.0);
comp_121=`  ret = fragColor;
comp_122=`}
