warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// ElSolem - Screening Rings / https://www.shadertoy.com/view/43B3RV
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_14=`  uv += float2(0,0) + 0;
comp_15=`  uv *= float2(1,1) * 1;
comp_16=`
comp_17=`  // Normalized pixel coordinates (from 0 to 1)
comp_18=`  // float2 uv = fragCoord/uv.xy * 2. - 1.;
comp_19=`  //uv.x *= uv.x / uv.y;
comp_20=`
comp_21=`  // Time varying pixel color
comp_22=`  float3 col = 0.5 + 0.5*tan(time+uv.xyx+float3(0,2,4));
comp_23=`
comp_24=`  float d = length(uv);
comp_25=`  d = sin(d*8. + time)/8.;
comp_26=`  d = tan(d);
comp_27=`
comp_28=`  d = .02/d;
comp_29=`
comp_30=`  col *= d;
comp_31=`  // Output to screen
comp_32=`  fragColor = float4(col, 1.0);
comp_33=`  ret = fragColor;
comp_34=`}
