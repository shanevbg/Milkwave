nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// itishappy - Refraction I / https://www.shadertoy.com/view/43XSz2
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 color = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_14=`  uv += float2(0,0.8);
comp_15=`  uv *= float2(1,1) * 1;
comp_16=`
comp_17=`  float2 coord  = uv;
comp_18=`
comp_19=`  float n1 = 1.0,
comp_20=`  n2 = 1.5,
comp_21=`  lambda = 0.1,
comp_22=`  t = time,
comp_23=`  theta1 = 0.8 * cos(0.15 * t),
comp_24=`  theta2 = asin(n1 / n2 * sin(theta1));
comp_25=`
comp_26=`  float2 res = uv,
comp_27=`  r = (2.0 * coord - res) / res.y,
comp_28=`  k1 = n1 / lambda * float2(cos(theta1), sin(theta1)),
comp_29=`  k2 = n2 / lambda * float2(cos(theta2), sin(theta2));
comp_30=`
comp_31=`  float a1 = cos(dot(k1, r) - t * 2.0),
comp_32=`  a2 = cos(dot(k2, r) - t * 2.0),
comp_33=`  a = lerp(a1, a2, step(0.0, r.x));
comp_34=`
comp_35=`  float3 col = 0.5 + 0.5 * cos(t + r.xyx + float3(0, 2, 4));
comp_36=`
comp_37=`  color.xyz = a * a * col;
comp_38=`  ret = color;
comp_39=`}
