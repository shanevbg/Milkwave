MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// NikoAnimation - psychedelic checkerboard / https://www.shadertoy.com/view/4cVXz3
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`shader_body {
comp_13=`  float4 fragColor = 0;
comp_14=`  // CONV: Center on screen, then try some aspect correction
comp_15=`  uv = (uv*2) - 1;
comp_16=`  uv *= aspect.xy;
comp_17=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_18=`  uv = float2(uv.x, -uv.y);
comp_19=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_20=`  uv += float2(0,0) + 0;
comp_21=`  uv *= float2(1,1) * 1000;
comp_22=`  float2 fragCoord  = uv;
comp_23=`
comp_24=`  float tileSize1 = (sin(time/2.0)+2.0)*50.0;
comp_25=`  float tileSize2 = (sin(time/2.5)+2.0)*50.0;
comp_26=`  float tileSize3 = (sin(time/3.0)+2.0)*50.0;
comp_27=`  float tileSize4 = 150.0;
comp_28=`  float b1 = 0.0;
comp_29=`  float b2 = 0.0;
comp_30=`  float b3 = 0.0;
comp_31=`  float b4 = 0.0;
comp_32=`  float2 pos1 = floor(fragCoord/tileSize1);
comp_33=`  float2 pos2 = floor(fragCoord/tileSize2);
comp_34=`  float2 pos3 = floor(fragCoord/tileSize3);
comp_35=`  float2 pos4 = floor((fragCoord-time*20.0)/tileSize4);
comp_36=`
comp_37=`  if (mod_conv(pos1.x+pos1.y, 2.0) == 1.0) {
comp_38=`    b1 = 0.1;
comp_39=`  }
comp_40=`
comp_41=`  else {
comp_42=`    b1 = 1.0;
comp_43=`  }
comp_44=`
comp_45=`  if (mod_conv(pos2.x+pos2.y, 2.0) == 1.0) {
comp_46=`    b2 = 0.5*sin(time);
comp_47=`  }
comp_48=`
comp_49=`  else {
comp_50=`    b2 = 1.0;
comp_51=`  }
comp_52=`
comp_53=`  if (mod_conv(pos3.x+pos3.y, 2.0) == 1.0) {
comp_54=`    b3 = 0.5*cos(time);
comp_55=`  }
comp_56=`
comp_57=`  else {
comp_58=`    b3 = 0.8;
comp_59=`  }
comp_60=`
comp_61=`  if (mod_conv(pos4.x+pos4.y, 2.0) == 1.0) {
comp_62=`    b4 = 0.0;
comp_63=`  }
comp_64=`
comp_65=`  else {
comp_66=`    b4 = 1.0;
comp_67=`  }
comp_68=`
comp_69=`  float3 c1 = float3(b1, 0, 0);
comp_70=`  float3 c2 = float3(0, 0, b2);
comp_71=`  float3 c3 = float3(0, b3, 0);
comp_72=`  float3 c4 = float3(b4, b4, b4)/(2.5+(0.5*sin(time)));
comp_73=`  fragColor = float4(c4+(c1+c2+c3), 1.0);
comp_74=`  ret = fragColor;
comp_75=`}
