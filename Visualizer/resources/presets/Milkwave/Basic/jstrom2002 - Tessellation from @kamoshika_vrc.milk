MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// jstrom2002 - Tessellation from @kamoshika_vrc / https://www.shadertoy.com/view/3lyfDm
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`float3 rgb2hsv(float3 c)
comp_13=`{
comp_14=`  float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
comp_15=`  float4 p = lerp(float4(c.bg, K.wz), float4(c.gb, K.xy), step(c.b, c.g));
comp_16=`  float4 q = lerp(float4(p.xyw, c.r), float4(c.r, p.yzx), step(p.x, c.r));
comp_17=`
comp_18=`  float d = q.x - min(q.w, q.y);
comp_19=`  float e = 1.0e-10;
comp_20=`  return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
comp_21=`}
comp_22=`
comp_23=`float fsnoise(float2 c){
comp_24=`  return frac(sin(dot(c, float2(12.9898, 78.233))) * 43758.5453);
comp_25=`}
comp_26=`
comp_27=`shader_body {
comp_28=`  float4 fragColor = 0;
comp_29=`  float2 fragCoord  = uv;
comp_30=`  // CONV: Center on screen, then try some aspect correction
comp_31=`  uv = (uv*2) - 1;
comp_32=`  uv *= aspect.xy;
comp_33=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_34=`  uv = float2(uv.x, -uv.y);
comp_35=`  uv += float2(0.0, 0.0);
comp_36=`  uv *= float2(1.0, 1.0);
comp_37=`
comp_38=`  // float2 uv = fragCoord;// [0,uv] coords
comp_39=`//  uv *= 2.0;
comp_40=`  // zoom out.
comp_41=`
comp_42=`  // Pattern generation.
comp_43=`  float2 p=uv*2/.4 + time; // .xy/uv.y*4. + time;
comp_44=`  float2 I=floor(p/4.);
comp_45=`  p = mod_conv(p,4.) - 2.0;
comp_46=`  float i;
comp_47=`  for(;i++<9.;){
comp_48=`    p=abs(p)-1.;
comp_49=`    p/=dot(p,p);
comp_50=`    if(length(p)<1.)
comp_51=`    // CONV: break unsupported, see Milkwave manual
comp_52=`    i=10;
comp_53=`  }
comp_54=`
comp_55=`  float4 o;
comp_56=`  o.rgb = rgb2hsv(float3(fsnoise(I+i*.1),1.,1.))/abs(sin(max(p.x,p.y)*5.))/i;
comp_57=`
comp_58=`  // Output to screen
comp_59=`  fragColor = float4(o.rgb,1.0);
comp_60=`  ret = fragColor;
comp_61=`}
