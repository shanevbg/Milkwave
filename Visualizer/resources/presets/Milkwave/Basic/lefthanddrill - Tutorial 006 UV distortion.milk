b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// lefthanddrill - Tutorial 006 UV distortion / https://www.shadertoy.com/view/33sXRj
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float hash(float2 p) {
comp_7=`  return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
comp_8=`}
comp_9=`
comp_10=`float noise(float2 p) {
comp_11=`  float2 i = floor(p);
comp_12=`  float2 f = frac(p);
comp_13=`  float2 u = f * f * (3.0 - 2.0 * f);
comp_14=`  return lerp(
comp_15=`  lerp(hash(i + float2(0.0, 0.0)), hash(i + float2(1.0, 0.0)), u.x),
comp_16=`  lerp(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x),
comp_17=`  u.y
comp_18=`  );
comp_19=`}
comp_20=`
comp_21=`shader_body {
comp_22=`  float4 fragColor = 0;
comp_23=`  float2 fragCoord = uv;
comp_24=`  // CONV: Center on screen, then try some aspect correction
comp_25=`  uv = (uv*2) - 1;
comp_26=`  uv *= aspect.xy;
comp_27=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_28=`  uv = float2(uv.x, -uv.y);
comp_29=`
comp_30=`  // float2 uv = fragCoord.xy / uv.xy;
comp_31=`  // compute flow direction via noise-generated angle
comp_32=`  float scale = 3.0;
comp_33=`  float2 p = uv * scale;
comp_34=`  float angle = noise(p + time) * 6.2831853;
comp_35=`  float2 flow = float2(cos(angle), sin(angle));
comp_36=`  // warp uv by flow
comp_37=`  uv += flow * 0.1;
comp_38=`  // display warped coordinates in color channels
comp_39=`  float3 col = float3(uv.x, uv.y, 0.5 + 0.5 * sin(time));
comp_40=`  fragColor = float4(col, 1.0);
comp_41=`  ret = fragColor;
comp_42=`}
