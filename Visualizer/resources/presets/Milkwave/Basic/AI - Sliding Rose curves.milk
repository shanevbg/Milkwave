warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// AI - Sliding Rose curves / https://www.shadertoy.com/view/3lcyR7
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`float4 moveShapes(float2 st, float scale, float speed){
comp_13=`  st *= scale;
comp_14=`  float time_conv = time*speed;
comp_15=`  if( frac(time_conv)>0.5 ){
comp_16=`    if (step(1.,mod_conv(st.y,2.))>0.){
comp_17=`      st.x += 2.*frac(time_conv);
comp_18=`    }
comp_19=`
comp_20=`    else {
comp_21=`      st.x -= 2.*frac(time_conv);
comp_22=`    }
comp_23=`
comp_24=`  }
comp_25=`
comp_26=`  else {
comp_27=`    if (step(1.,mod_conv(st.x,2.))>0.){
comp_28=`      st.y += 2.*frac(time_conv);
comp_29=`    }
comp_30=`
comp_31=`    else {
comp_32=`      st.y -= 2.*frac(time_conv);
comp_33=`    }
comp_34=`
comp_35=`  }
comp_36=`
comp_37=`  return float4(frac(st),floor(st));
comp_38=`}
comp_39=`
comp_40=`float rose(float2 st){
comp_41=`  float gray;
comp_42=`  float2 pos = st-float2(0.5, 0.5);
comp_43=`  float r =(2.+.5*sin(time))*length(pos);
comp_44=`  float a = atan2(pos.y,pos.x);
comp_45=`  float f =abs(cos(a*(1.+mod_conv(5.+5.*sin(time),11.))))*.7+.1;
comp_46=`  gray=smoothstep(f-.5,f,r)-smoothstep(f,f+0.5,r);
comp_47=`  return gray;
comp_48=`}
comp_49=`
comp_50=`shader_body {
comp_51=`  float4 fragColor = 0;
comp_52=`  float2 fragCoord  = uv;
comp_53=`  // CONV: Center on screen, then try some aspect correction
comp_54=`  uv = (uv*2) - 1;
comp_55=`  uv *= aspect.xy;
comp_56=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_57=`  uv = float2(uv.x, -uv.y);
comp_58=`
comp_59=`  // float2 uv = fragCoord.xy/uv.xy;
comp_60=`  float3 color = float3(0.0, 0.0, 0.0);
comp_61=`  // set the number of shapes by the value of scale
comp_62=`  float scale=6;
comp_63=`  if (mouse.z) {
comp_64=`    scale *= (mouse.x)*3;
comp_65=`  }
comp_66=`  // set the speed of sliding
comp_67=`  float speed=.5;
comp_68=`  float4 uvij = moveShapes(uv,scale,speed);
comp_69=`  float shape=rose(uvij.xy);
comp_70=`  // flag is used to alternate colors
comp_71=`  float flag=mod_conv(uvij.z+uvij.w,2.);
comp_72=`  color = shape*float3(1.,flag,flag);
comp_73=`
comp_74=`  fragColor = float4(color,1.0);
comp_75=`  ret = fragColor;
comp_76=`}
