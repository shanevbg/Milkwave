warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// zhuo2 - vortex/ / https://www.shadertoy.com/view/4cGBRG
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`
comp_9=`  // CONV: Center on screen, then try some aspect correction
comp_10=`  uv = (uv*2) - 1;
comp_11=`  uv *= aspect.xy;
comp_12=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_13=`  uv = float2(uv.x, -uv.y);
comp_14=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_15=`  uv += float2(0,0) + 0;
comp_16=`  uv *= float2(1,1) * 1.5;
comp_17=`
comp_18=`  // float2 uv = (fragCoord.xy / uv.xy) * 2.0 - 1.0;
comp_19=`  //uv.x *= uv.x / uv.y;
comp_20=`
comp_21=`  float radius = length(uv);
comp_22=`  float angle = atan2(uv.y, uv.x);
comp_23=`
comp_24=`  float twist = sin(angle * 8.0 + radius * 20.0 - time * 5.0) * 0.5;
comp_25=`  float rift = abs(twist - 0.2 * cos(radius * 10.0 - time));
comp_26=`
comp_27=`  float glow = exp(-rift * 15.0) * 1.5;
comp_28=`  float edge = smoothstep(0.1, 0.08, rift);
comp_29=`
comp_30=`  float3 baseColor = float3(0.2, 0.1, 0.5);
comp_31=`  float3 riftColor = float3(0.8, 0.2, 0.3) + 0.5 * sin(time + float3(0.0, 2.0, 4.0));
comp_32=`  float3 color = lerp(baseColor, riftColor, edge);
comp_33=`
comp_34=`  color += glow * float3(1.0, 0.8, 0.5);
comp_35=`
comp_36=`  float noise = frac(sin(dot(uv, float2(12.9898, 78.233))) * 43758.5453);
comp_37=`  color += 0.05 * noise * float3(1.0, 0.8, 0.6);
comp_38=`
comp_39=`  float vignette = 1.0 - smoothstep(0.8, 1.0, radius);
comp_40=`  color *= vignette;
comp_41=`
comp_42=`  fragColor = float4(color, 1.0);
comp_43=`  ret = fragColor;
comp_44=`}
