b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// TEttinger - Voronoise (Readability Edit) / https://www.shadertoy.com/view/3llfW8
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float2 rand2(float2 p)
comp_7=`{
comp_8=`  float2 q = float2(dot(p,float2(127.1,311.7)),
comp_9=`  dot(p,float2(269.5,183.3)));
comp_10=`  return frac(sin(q)*43758.5453);
comp_11=`}
comp_12=`
comp_13=`float rand(float2 p)
comp_14=`{
comp_15=`  return frac(sin(dot(p,float2(419.2,371.9))) * 833458.57832);
comp_16=`}
comp_17=`
comp_18=`float iqnoise(in float2 pos, float irregular, float smoothness)
comp_19=`{
comp_20=`  float2 cell = floor(pos);
comp_21=`  float2 cellOffset = frac(pos);
comp_22=`
comp_23=`  float sharpness = 1.0 + 63.0 * pow(1.0-smoothness, 4.0);
comp_24=`
comp_25=`  float value = 0.0;
comp_26=`  float accum = 0.0;
comp_27=`  for(int x=-2; x<=2; x++ )
comp_28=`  for(int y=-2; y<=2; y++ )
comp_29=`  {
comp_30=`    float2 samplePos = float2(float(y), float(x));
comp_31=`
comp_32=`    float2 center = rand2(cell + samplePos) * irregular;
comp_33=`    float centerDistance = length(samplePos - cellOffset + center);
comp_34=`
comp_35=`    float sam = pow(1.0 - smoothstep(0.0, 1.414, centerDistance), sharpness);
comp_36=`
comp_37=`    float color = rand(cell + samplePos);
comp_38=`    value += color * sam;
comp_39=`    accum += sam;
comp_40=`  }
comp_41=`
comp_42=`  return value/accum;
comp_43=`}
comp_44=`
comp_45=`shader_body {
comp_46=`  float4 fragColor = 0;
comp_47=`  float2 fragCoord  = uv;
comp_48=`  // CONV: Center on screen, then try some aspect correction
comp_49=`  //uv = (uv) - 1;
comp_50=`  uv *= aspect.xy;
comp_51=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_52=`  uv = float2(uv.x, -uv.y);
comp_53=`
comp_54=`  // float2 uv = fragCoord.xy / uv.xx;
comp_55=`
comp_56=`  float2 p = 0.5 - 0.5*sin( time*float2(1.01,1.71) );
comp_57=`
comp_58=`  if(mouse.w > 0.001)
comp_59=`  p = float2(0.0,1.0) + float2(1.0,-1.0)*mouse.xy/uv.xy;
comp_60=`
comp_61=`  p = p*p*(3.0-2.0*p);
comp_62=`  p = p*p*(3.0-2.0*p);
comp_63=`  p = p*p*(3.0-2.0*p);
comp_64=`
comp_65=`  float f = iqnoise( 24.0*uv, p.x, p.y );
comp_66=`
comp_67=`  fragColor = float4( f, f, f, 1.0 );
comp_68=`  ret = fragColor;
comp_69=`}
