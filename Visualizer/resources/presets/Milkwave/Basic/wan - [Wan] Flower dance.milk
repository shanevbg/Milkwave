MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// wan - [Wan] Flower dance / https://www.shadertoy.com/view/3ls3DS
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`#define PI 3.14159
comp_13=`
comp_14=`float sstep(float a, float x) {
comp_15=`  return smoothstep(a*0.98, a*1.02, x);
comp_16=`}
comp_17=`
comp_18=`float flower(float2 p) {
comp_19=`  float a = atan2(p.y, p.x);
comp_20=`  float r = length(p);
comp_21=`  float arms = a*(5. + ceil((sin(time*3.)+.215)*5.));
comp_22=`  return sstep(.5,r + sin(arms)/3);
comp_23=`}
comp_24=`
comp_25=`float2 rot(float2 p, float a) {
comp_26=`  return float2(p.x*cos(a)-p.y*sin(a),p.y*cos(a)+p.x*sin(a));
comp_27=`}
comp_28=`
comp_29=`shader_body {
comp_30=`  float4 fragColor = 0;
comp_31=`
comp_32=`  // CONV: Center on screen, then try some aspect correction
comp_33=`  uv = (uv*2) - 1;
comp_34=`  uv *= aspect.xy;
comp_35=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_36=`  uv = float2(uv.x, -uv.y);
comp_37=`
comp_38=`  float2 fragCoord  = uv;
comp_39=`  
comp_40=`  float2 p = uv; //( 2.*fragCoord.xy - uv.xy ) / uv.y;
comp_41=`  p *= 2;
comp_42=`  
comp_43=`  float2 p1 = mod_conv(p*5., 2.)-1.;
comp_44=`  float3 color = lerp(float3(.5,.2,.0),
comp_45=`  float3(.9,.9,.1),
comp_46=`  flower(p1) - flower(.8*p1));
comp_47=`  color += lerp(float3(.5,.2,.0),
comp_48=`  float3(.8,.7,.4),
comp_49=`  flower(p*.8)) * .9;
comp_50=`  color *= lerp(float3(1.,1.,1.),
comp_51=`  float3(.8,.8,.8),
comp_52=`  flower(p*.4));
comp_53=`
comp_54=`  fragColor = float4( float3( color ), 1.0 );
comp_55=`
comp_56=`  ret = fragColor;
comp_57=`}
