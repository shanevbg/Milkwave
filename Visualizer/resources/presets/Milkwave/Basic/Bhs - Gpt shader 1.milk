warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Bhs - Gpt shader 1 / https://www.shadertoy.com/view/3XSSRc
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  float2 fragCoord = uv;
comp_9=`  // CONV: Center on screen, then try some aspect correction
comp_10=`  uv = (uv*2) - 1;
comp_11=`  uv *= aspect.xy;
comp_12=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_13=`  uv = float2(uv.x, -uv.y);
comp_14=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_15=`  uv += float2(0,0) + 0;
comp_16=`  uv *= float2(1,1) * 1;
comp_17=`
comp_18=`  // float2 uv = (fragCoord - 0.5 * uv.xy) / uv.y;
comp_19=`  float time_conv = time * 0.5;
comp_20=`
comp_21=`  // Simulate a beat frequency
comp_22=`  float beat = sin(time * 2.0) * 0.5 + 0.5;
comp_23=`
comp_24=`  // Radial pattern
comp_25=`  float angle = atan2(uv.y, uv.x);
comp_26=`  float radius = length(uv);
comp_27=`
comp_28=`  // Spiral + pulse
comp_29=`  float spiral = sin(10.0 * radius - time_conv * 4.0 + angle * 5.0);
comp_30=`  float pulse = sin(30.0 * radius - time_conv * 10.0) * 0.5 + 0.5;
comp_31=`  float ring = smoothstep(0.01, 0.02, abs(spiral) * pulse);
comp_32=`
comp_33=`  // Color cycle
comp_34=`  float3 color = 0.5 + 0.5 * cos(time_conv + float3(0.0, 2.0, 4.0));
comp_35=`  color *= ring;
comp_36=`
comp_37=`  // Glow
comp_38=`  color *= 1.0 / (radius * 5.0 + 0.1);
comp_39=`
comp_40=`  fragColor = float4(color, 1.0);
comp_41=`  ret = fragColor;
comp_42=`}
