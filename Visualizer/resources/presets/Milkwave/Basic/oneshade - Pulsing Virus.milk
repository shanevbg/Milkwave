b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// oneshade - Pulsing Virus / https://www.shadertoy.com/view/3sGBR3
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float noise(in float2 p) {
comp_7=`  return frac(sin(p.x * 17.6452 + p.y * 565.337) * 5425.235);
comp_8=`}
comp_9=`
comp_10=`float SmoothNoise(in float2 p) {
comp_11=`  float2 luv_conv = smoothstep(0.0, 1.0, frac(p));
comp_12=`  // :P
comp_13=`  float2 cid = floor(p);
comp_14=`
comp_15=`  float bl = noise(cid);
comp_16=`  float br = noise(cid + float2(1.0, 0.0));
comp_17=`  float tl = noise(cid + float2(0.0, 1.0));
comp_18=`  float tr = noise(cid + float2(1.0, 1.0));
comp_19=`
comp_20=`  return lerp(lerp(bl, br, luv_conv.x), lerp(tl, tr, luv_conv.x), luv_conv.y);
comp_21=`}
comp_22=`
comp_23=`float FractalNoise(in float2 p, in float scale, in float octaves) {
comp_24=`  float value = 0.0;
comp_25=`  float nscale = 1.0;
comp_26=`  float tscale = 0.0;
comp_27=`
comp_28=`  for (float octave=0.0; octave < octaves; octave++) {
comp_29=`    value += SmoothNoise(p * pow(2.0, octave) * scale) * nscale;
comp_30=`    tscale += nscale;
comp_31=`    nscale *= 0.5;
comp_32=`  }
comp_33=`
comp_34=`  return value / tscale;
comp_35=`}
comp_36=`
comp_37=`shader_body {
comp_38=`  float4 fragColor = 0;
comp_39=`  float2 fragCoord = uv;
comp_40=`  // CONV: Center on screen, then try some aspect correction
comp_41=`  uv = (uv*2) - 1;
comp_42=`  uv *= aspect.xy;
comp_43=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_44=`  uv = float2(uv.x, -uv.y);
comp_45=`  uv += float2(0.0, 0.0);
comp_46=`  uv *= float2(1.0, 1.0);
comp_47=`
comp_48=`  // float2 uv = (fragCoord - 0.5 * uv.xy) / uv.y;
comp_49=`  float3 ro = float3(0.0, 0.0, 5.0);
comp_50=`  float3 rd = normalize(float3(uv, -1.0));
comp_51=`  float colorChange = 0.8 + 0.4 * sin(3.5 * time);
comp_52=`  fragColor = float4(0.0, 0.0, 0.0, 1.0);
comp_53=`  fragColor.rg += 0.75 * (2.0 - colorChange) / 1.5 * (1.5 - length(uv)) / 1.5;
comp_54=`
comp_55=`  float dt = 0.0;
comp_56=`  for (int iter=0; iter < 50; iter++) {
comp_57=`    float3 p = ro + rd * dt;
comp_58=`
comp_59=`    float c = cos(time), s = sin(time);
comp_60=`    p.xz = mul(p.xz, transpose(float2x2(c, s, -s, c)));
comp_61=`
comp_62=`    float h = FractalNoise(float2(atan2(p.z, p.x), atan2(p.y, length(p.xz))), 10.0, 4.0);
comp_63=`    float d = length(p) - 2.0 + h;
comp_64=`
comp_65=`    if (d < 0.001) {
comp_66=`      fragColor.rgb = lerp(float3(1.0, 0.0, 0.0), float3(1.0, 1.0, 0.0) * 2.0 * h * (1.0 + colorChange), h);
comp_67=`      // CONV: break unsupported, see Milkwave manual
comp_68=`      iter = 50;
comp_69=`    }
comp_70=`
comp_71=`    if (dt > 10.0) {
comp_72=`      // CONV: break unsupported, see Milkwave manual
comp_73=`      iter = 50;
comp_74=`    }
comp_75=`
comp_76=`    dt += d;
comp_77=`  }
comp_78=`
comp_79=`  ret = fragColor;
comp_80=`}
