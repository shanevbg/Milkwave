warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// kit_spin - fun spiral / https://www.shadertoy.com/view/3sfBW4
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float drawspiral(in float wingsize, float fuzz, float d, float offset,
comp_7=`float wings, float zoom, float speed, float nudge){
comp_8=`  return smoothstep(wingsize, wingsize+fuzz,
comp_9=`  abs(sin(d*zoom+
comp_10=`  offset*wings+
comp_11=`  time*speed+
comp_12=`  nudge)));
comp_13=`}
comp_14=`
comp_15=`shader_body {
comp_16=`  float4 fragColor = 0;
comp_17=`  float2 fragCoord  = uv;
comp_18=`  // CONV: Center on screen, then try some aspect correction
comp_19=`  uv = (uv*2) - 1;
comp_20=`  uv *= aspect.xy;
comp_21=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_22=`  uv = float2(uv.x, -uv.y);
comp_23=`  uv += float2(-0.6, 0.5);
comp_24=`  uv *= float2(1, 1.5)*0.7;
comp_25=`
comp_26=`  float2 st = uv; //fragCoord.xy/uv.xy;
comp_27=`  float3 color = float3(0.0, 0.0, 0.0);
comp_28=`  float d = 0.0;
comp_29=`
comp_30=`  // Place origin at center of screen
comp_31=`  st = st *2.00-1.000;
comp_32=`  st.x *= uv.x;
comp_33=`
comp_34=`  // Concentric circles distance map from center
comp_35=`  d = length( abs(st) );
comp_36=`
comp_37=`  // Nudge pixels towards the center relative to the angle from the X axis
comp_38=`  float offset = (atan(st.y/st.x));
comp_39=`
comp_40=`  // Unfocus edgest more when closer to center
comp_41=`  float focus = pow(d,-.5)/2.00;
comp_42=`
comp_43=`  // Edit these things for fun and profit
comp_44=`  // (size , fuzz 	  , d, offset, wings, zoom , speed, nudge)
comp_45=`  float r = drawspiral(0.700, 0.20*focus, d, offset,
comp_46=`  6.000, 10.0, 1.000, time);
comp_47=`  float g = drawspiral(0.700, 0.20*focus, d, offset,
comp_48=`  6.000, 10.*sin(time/3.0 ), 1.000, 2.000);
comp_49=`  float b = drawspiral(0.700, 0.20*focus, d, offset,
comp_50=`  6.000, 10.*sin(time/3.0 +1.57078), 1.000, 2.200);
comp_51=`
comp_52=`  color = float3(r,g,b);
comp_53=`
comp_54=`  fragColor = float4(color, 1);
comp_55=`
comp_56=`  // uncomment this line to force black and white and read only from 'b' only
comp_57=`  // fragColor = float4(float3(b), 1);
comp_58=`
comp_59=`  ret = fragColor;
comp_60=`}
