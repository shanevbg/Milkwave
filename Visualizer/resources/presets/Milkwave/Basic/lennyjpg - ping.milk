warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// lennyjpg - ping / https://www.shadertoy.com/view/3djcWW
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`# define PI 3.141592653589793
comp_7=`float rand(float2 co){
comp_8=`  return frac(sin(dot(co.xy ,float2(12.9898,78.233))) * 43758.5453);
comp_9=`}
comp_10=`
comp_11=`shader_body {
comp_12=`  float4 fragColor = 0;
comp_13=`  float2 fragCoord  = uv;
comp_14=`  // CONV: Center on screen, then try some aspect correction
comp_15=`  uv = (uv*2) - 1;
comp_16=`  uv *= aspect.xy;
comp_17=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_18=`  uv = float2(uv.x, -uv.y);
comp_19=`
comp_20=`  // float2 uv = fragCoord.xy/uv.y;
comp_21=`  uv.y+=time*0.1;
comp_22=`
comp_23=`  float2 u = frac(uv.xy*5.)-0.5;
comp_24=`
comp_25=`  float z = 5.;
comp_26=`  float2 g = time*.02 + floor(uv * z);
comp_27=`  float b =  rand(floor(g + 3.321))*3.;
comp_28=`  float r =.7;
comp_29=`  float angle = PI*0.25+floor(rand(floor(g))*4.)*PI*0.5;
comp_30=`  u.x+=sin(angle)*r;
comp_31=`  u.y+=cos(angle)*r;
comp_32=`  float d = length(u*.3);
comp_33=`  // float k = smoothstep(d,d*1.01,0.5);
comp_34=`  float k = frac(d*3.0-time*(b-0.5)*0.2);
comp_35=`  k += sin(time * r + angle);
comp_36=`  k = sin(frac(k*.13)*1.5)*1.2;
comp_37=`  float3 cc = lerp( float3(.08, 0.15, 0.3), float3(1.2, 0.13, 0.2), k);
comp_38=`  fragColor = float4(cc,1.0);
comp_39=`  ret = fragColor;
comp_40=`}
