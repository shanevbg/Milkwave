warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Hexzeel - BOX RGB / https://www.shadertoy.com/view/4cGSzh
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_14=`  uv += float2(3,2);
comp_15=`  uv *= float2(1,1) * 0.8;
comp_16=`
comp_17=`  // float2 uv = fragCoord/uv.xy;
comp_18=`
comp_19=`  float a = length(cos(uv.x + cos(time) * 0.5 + 20.0)*0.5+0.5 * uv.y) * 30.0;
comp_20=`  float b = length(cos(uv.y + sin(time) * 0.5 + 20.0)*0.5+0.5 * uv.x) * 30.0;
comp_21=`
comp_22=`  float colorR = ( cos(b)*cos(a)* cos(time) * 15.0);
comp_23=`  float colorG = ( cos(a)*sin(b)* sin(time) * 10.0);
comp_24=`  float colorB = ( sin(b)*cos(a)* cos(time) * 25.0);
comp_25=`
comp_26=`  fragColor = float4(colorR,colorG,colorB,1.0);
comp_27=`  ret = fragColor;
comp_28=`}
