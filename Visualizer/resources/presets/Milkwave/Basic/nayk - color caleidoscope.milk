bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// nayk - color caleidoscope  / https://www.shadertoy.com/view/4c3yRX
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float cheap_star(float2 uv_conv,  float anim)
comp_7=`{
comp_8=`  uv_conv = abs(uv_conv);
comp_9=`  uv_conv*=float2(frac(log(length(uv_conv.xy))-time*.5), frac(log(length(uv_conv.xy))-time*.5));
comp_10=`  float2 pos = min(uv_conv.xy/uv_conv.yx, anim);
comp_11=`  float p = (2.0 - pos.x - pos.y);
comp_12=`  return (2.0+p*(p*p-1.5)) / (uv_conv.x+uv_conv.y);
comp_13=`}
comp_14=`
comp_15=`float3 palette( float t ) {
comp_16=`  float3 a = float3(0.5, 0.5, 0.5);
comp_17=`  float3 b = float3(0.5, 0.5, 0.5);
comp_18=`  float3 c = float3(1.0, 1.0, 1.0);
comp_19=`  float3 d = float3(0.263,0.416,0.557);
comp_20=`
comp_21=`  return a + b*cos( 6.28318*(c*t+d) );
comp_22=`}
comp_23=`
comp_24=`shader_body {
comp_25=`  float4 fragColor = 0;
comp_26=`  // CONV: Center on screen, then try some aspect correction
comp_27=`  uv = (uv*2) - 1;
comp_28=`  uv *= aspect.xy;
comp_29=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_30=`  uv = float2(uv.x, -uv.y);
comp_31=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_32=`  uv += float2(0,0) + 0;
comp_33=`  uv *= float2(1,1) * 1;
comp_34=`  float2 fragCoord  = uv;
comp_35=`
comp_36=`  float2 uv2 = uv; //(fragCoord * 2.0 - uv.xy) / uv.y;
comp_37=`  float2 uv0 = uv2;
comp_38=`  float3 finalColor = float3(0.0, 0.0, 0.0);
comp_39=`  uv2*=float2(frac(log(length(uv2.xy))+time*.5), frac(log(length(uv2.xy))+time*.5));
comp_40=`  for (float i = 0.0; i < 5.0; i++) {
comp_41=`    uv2 = frac(uv2 * 2.5) - 0.5;
comp_42=`    uv2*=float2(frac(log(length(uv2.xy))-time*.05), frac(log(length(uv2.xy))-time*.05));
comp_43=`    float d = length(uv2) * exp(-length(uv0));
comp_44=`
comp_45=`    float3 col = palette(length(uv0) + i*.4 + time*.4);
comp_46=`
comp_47=`    d = sin(d*8. + time)/8.;
comp_48=`    d = abs(d);
comp_49=`
comp_50=`    d = pow(0.01 / d, 1.2);
comp_51=`
comp_52=`    finalColor += col * d;
comp_53=`  }
comp_54=`
comp_55=`  // float2 uv = ( fragCoord - .5*uv.xy ) / uv.y;
comp_56=`  uv *= 2.0 * ( cos(time * 2.0) -2.5);
comp_57=`  // scale
comp_58=`  float anim = sin(time * 12.0) * 0.1 + 1.0;
comp_59=`  // anim between 0.9 - 1.1
comp_60=`  fragColor= float4(cheap_star(uv, anim)*finalColor * float3(0.55,0.5,0.55)*0.5, 1.0);
comp_61=`  ret = fragColor;
comp_62=`}
