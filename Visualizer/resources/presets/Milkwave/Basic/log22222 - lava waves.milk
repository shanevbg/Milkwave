warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// log22222 - lava waves / https://www.shadertoy.com/view/4cVcWG
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`#ifndef saturate
comp_13=`#define saturate(v) clamp(v,0.,1.)
comp_14=`
comp_15=`#endif
comp_16=`
comp_17=`float3 drawline(float3 col_i, float coord, float offset, float zoom_off, float width, float period, float3 color) {
comp_18=`  if( mod_conv( abs(coord + offset * zoom_off) , period) > width){
comp_19=`    col_i = color;
comp_20=`    };
comp_21=`    return col_i;
comp_22=`  }
comp_23=`
comp_24=`  float3 hsv2rgb(float3 c){
comp_25=`    float4 K=float4(1.,2./3.,1./3.,3.);
comp_26=`    return c.z*lerp(K.xxx,saturate(abs(frac(c.x+K.xyz)*6.-K.w)-K.x),c.y);
comp_27=`  }
comp_28=`
comp_29=`  float3 scratchlike_color(float hue, float sat, float val){
comp_30=`    return hsv2rgb( float3( mod_conv(hue, 1.0),sat,val));
comp_31=`  }
comp_32=`
comp_33=`  float2 rotate_uv(float degr, float2 uv_conv){
comp_34=`    float rot_x = float(uv_conv.x * cos(degr))+(uv_conv.y * sin(degr));
comp_35=`    float rot_y = float(uv_conv.y * cos(degr)) - (uv_conv.x * sin(degr));
comp_36=`
comp_37=`    return float2( rot_x , rot_y );
comp_38=`  }
comp_39=`
comp_40=`  shader_body {
comp_41=`    float4 fragColor = 0;
comp_42=`
comp_43=`    // CONV: Center on screen, then try some aspect correction
comp_44=`    uv = (uv*2) - 1;
comp_45=`    uv *= aspect.xy;
comp_46=`    // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_47=`    uv = float2(uv.x, -uv.y);
comp_48=`    // CONV: Adjust viewpoint (x,y individually or both)
comp_49=`    uv += float2(0,0) + 0;
comp_50=`    uv *= float2(1,1) * 100;
comp_51=`
comp_52=`    // float2 uv = ((fragCoord-uv.xy/2.0)/uv.x)*250.0;
comp_53=`
comp_54=`    float rot_x = float(uv.x * cos(time/4.0))+(uv.y * sin(time/4.0));
comp_55=`    float rot_y = float(uv.y * cos(time/4.0)) - (uv.x * sin(time/4.0));
comp_56=`
comp_57=`    // uv = float2( rot_x , rot_y );
comp_58=`
comp_59=`    // float2 offset = float2(sin(time/20.)*20., -sin(time/20.)*20.) * 25.0;
comp_60=`
comp_61=`    float2 offset = float2(time * 10., 0);
comp_62=`
comp_63=`    // float zoomlvl = 2. + (1.5 - pow(sin(time/1.), 4.)*1.5);
comp_64=`
comp_65=`    float zoomlvl = 1.;
comp_66=`
comp_67=`    uv = uv * zoomlvl;
comp_68=`
comp_69=`    // Time varying pixel color
comp_70=`
comp_71=`    // float3 col = 0.5 + 0.5*cos(uv.xyx+float3(0,2,4));
comp_72=`    float3 col = scratchlike_color(0.1,0.65,0.9);
comp_73=`
comp_74=`    float3 cl_1 = float3(0.0, 0.0, 0.0);
comp_75=`
comp_76=`    float sigma_linecount = 4.0;
comp_77=`
comp_78=`    for(float i = 1.0; i <= sigma_linecount; i++)
comp_79=`    {
comp_80=`      float mscale = 4.;
comp_81=`
comp_82=`      float istep = i/sigma_linecount;
comp_83=`
comp_84=`      float istep_mscaled = istep * mscale;
comp_85=`
comp_86=`      float powfc = 1.75;
comp_87=`      // + (0.5 + cos(time/2.)/2.);
comp_88=`
comp_89=`      float curved_i = pow(istep_mscaled, powfc);
comp_90=`      float opposite_c_i = pow(sigma_linecount, powfc) - curved_i;
comp_91=`
comp_92=`      float stepping_sine = pow(sin(time * curved_i /6.0 + curved_i /2.0) + 1.5, 0.15);
comp_93=`
comp_94=`      if (mod_conv(uv.y - time*6., 30.) < 15.){
comp_95=`        uv.x += stepping_sine/1.5 + (60. + curved_i*7. - (20. + curved_i * 5.75)) * 1.05;
comp_96=`      }
comp_97=`
comp_98=`      float2 local_uv = rotate_uv(sin(time/1. + curved_i)/4., uv);
comp_99=`
comp_100=`      local_uv.x = local_uv.x + sin(local_uv.y/20.+time*3.)*2.;
comp_101=`
comp_102=`      offset.x +=  stepping_sine/0.4;
comp_103=`
comp_104=`      cl_1 = scratchlike_color(0. + curved_i/500.0,0.65,0.9-curved_i/20.);
comp_105=`      col = drawline(col, local_uv.x, offset.x, (1.0 + curved_i /3.0), 20. + curved_i * 5.75, 60. + curved_i*7. , cl_1);
comp_106=`      // col = drawline(col, uv.y, offset.y, (1.0 + curved_i /7.0), 14. + curved_i * 3.25, 15. + curved_i*4. , cl_1);
comp_107=`    }
comp_108=`
comp_109=`    /*
comp_110=`    cl_1 = scratchlike_color(.09);
comp_111=`
comp_112=`    col = drawline(col, uv.x, offset.x, 1.15, 14, 22, cl_1);
comp_113=`    col = drawline(col, uv.y, offset.y, 1.15, 14, 22, cl_1);
comp_114=`
comp_115=`    cl_1 = scratchlike_color(.14);
comp_116=`
comp_117=`    col = drawline(col, uv.x, offset.x, 1.3, 22, 36, cl_1);
comp_118=`    col = drawline(col, uv.y, offset.y, 1.3, 22, 36, cl_1);
comp_119=`
comp_120=`    cl_1 = scratchlike_color(.2);
comp_121=`
comp_122=`    col = drawline(col, uv.x, offset.x, 1.45, 35, 52, cl_1);
comp_123=`    col = drawline(col, uv.y, offset.y, 1.45, 35, 52, cl_1);
comp_124=`    */
comp_125=`
comp_126=`    // Output to screen
comp_127=`    fragColor = float4(col,1.0);
comp_128=`
comp_129=`    ret = fragColor;
comp_130=`  }
