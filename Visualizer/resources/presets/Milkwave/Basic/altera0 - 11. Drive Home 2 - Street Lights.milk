warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// altera0 - 11. Drive Home 2 - Street Lights / https://www.shadertoy.com/view/3tXfRX
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define S( a , b , t ) smoothstep( a , b , t )
comp_7=`
comp_8=`struct Ray {
comp_9=`  float3 ro;
comp_10=`  // Ray Origin
comp_11=`  float3 rd;
comp_12=`  // Ray Direction
comp_13=`  };
comp_14=`
comp_15=`  Ray GetRay( float2 uv_conv , float3 camPos , float camZoom , float3 lookAt ) {
comp_16=`
comp_17=`    Ray ray;
comp_18=`
comp_19=`    ray.ro = camPos;
comp_20=`
comp_21=`    float3 F = normalize( lookAt - camPos );
comp_22=`    float3 R = normalize( cross( float3( 0 , 1 , 0 ) , F ) );
comp_23=`    float3 U = cross( F , R );
comp_24=`
comp_25=`    float3 center  = camPos + F * camZoom;
comp_26=`    float3 intersectionPoint = center + uv_conv.x * R  + uv_conv.y * U;
comp_27=`
comp_28=`    ray.rd = normalize( intersectionPoint - camPos );
comp_29=`
comp_30=`    return ray;
comp_31=`  }
comp_32=`
comp_33=`  float3 GetClosestPoint( Ray ray , float3 targetPos ) {
comp_34=`
comp_35=`    return ray.ro + max( 0.0f , dot( targetPos - ray.ro , ray.rd ) ) * ray.rd;
comp_36=`  }
comp_37=`
comp_38=`  float GetDistance( Ray ray , float3 targetPos ) {
comp_39=`    float d = length( targetPos - GetClosestPoint( ray , targetPos ) );
comp_40=`    return d;
comp_41=`  }
comp_42=`
comp_43=`  float Boke( float d , float lightDiameter , float blur ) {
comp_44=`
comp_45=`    float c = S( lightDiameter , lightDiameter * ( 1.0f - blur ) , d );
comp_46=`    c *= lerp( 0.7f , 1.0f , S( lightDiameter * 0.8f , lightDiameter , d ) );
comp_47=`    return c;
comp_48=`  }
comp_49=`
comp_50=`  float Noise(float t) {
comp_51=`    float n;
comp_52=`
comp_53=`    n = sin( t + 2379. ) ;
comp_54=`
comp_55=`    return n;
comp_56=`  }
comp_57=`
comp_58=`  float StreetLight( Ray ray , float lightDiameter, float bokeBlur , float time_conv ) {
comp_59=`    float c = 0.0f;
comp_60=`
comp_61=`    float t = time_conv * 0.1f;
comp_62=`    float s = 1.0f / 10.0f;
comp_63=`    // in 1 sec, 100 count.
comp_64=`    float side = step( ray.rd.x , 0.0f );
comp_65=`    ray.rd.x = abs( ray.rd.x );
comp_66=`    // reflect ray x
comp_67=`    for ( float i = 0.0f ; i < 1.0f ; i+=s ) {
comp_68=`
comp_69=`      float ti = frac(t + i + side * s * 0.5f );
comp_70=`      float3 targetPos = float3( 2.0f , 2.0f , 100.0f - ti * 100.0f );
comp_71=`      float d = GetDistance( ray , targetPos );
comp_72=`
comp_73=`      float expandLight = lightDiameter * length( targetPos );
comp_74=`      c += Boke( d , expandLight , bokeBlur ) * ti * ti * ti;
comp_75=`    }
comp_76=`
comp_77=`    return c;
comp_78=`  }
comp_79=`
comp_80=`  shader_body {
comp_81=`    float4 fragColor = 0;
comp_82=`    float2 fragCoord  = uv;
comp_83=`    // CONV: Center on screen, then try some aspect correction
comp_84=`    uv = (uv*2) - 1;
comp_85=`    uv *= aspect.xy;
comp_86=`    // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_87=`    uv = float2(uv.x, -uv.y);
comp_88=`    // CONV: Adjust viewpoint (x,y individually or both)
comp_89=`    uv += float2(0,0.25) + 0;
comp_90=`    uv *= float2(1,1) * 1;
comp_91=`
comp_92=`    // float2 uv = (fragCoord - 0.5f * uv.xy) / min( uv.x, uv.y);
comp_93=`
comp_94=`    float3 camPos = float3( 0 , 0.2f , 0.0f );
comp_95=`    float3 lookAt = float3( 0 , 0.2f , 1.0f );
comp_96=`    float camZoom = 2.0f;
comp_97=`
comp_98=`    float lightDiameter = 0.05f;
comp_99=`    float bokeBlur = 0.1f;
comp_100=`
comp_101=`    Ray ray = GetRay( uv , camPos , camZoom , lookAt );
comp_102=`
comp_103=`    float c = StreetLight( ray , lightDiameter , bokeBlur, time );
comp_104=`
comp_105=`    float3 col = float3( 1.0f , 0.7f , 0.3f) * c;
comp_106=`    fragColor = float4( col ,1.0);
comp_107=`    ret = fragColor;
comp_108=`  }
