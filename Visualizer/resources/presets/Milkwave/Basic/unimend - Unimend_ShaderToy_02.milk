warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// unimend - Unimend_ShaderToy_02 / https://www.shadertoy.com/view/43SyzD
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette(float t ){
comp_7=`
comp_8=`  float3 a =float3(0.212,0.729,0.729);
comp_9=`  float3 b =float3(0.758,0.618,0.438);
comp_10=`  float3 c =float3(0.090,0.510,0.137);
comp_11=`  float3 d =float3(-0.012,0.5,0.667);
comp_12=`
comp_13=`  return a + b*cos( 6.283185*(c*t+d) );
comp_14=`}
comp_15=`
comp_16=`shader_body {
comp_17=`  float4 fragColor = 0;
comp_18=`  // CONV: Center on screen, then try some aspect correction
comp_19=`  uv = (uv*2) - 1;
comp_20=`  uv *= aspect.xy;
comp_21=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_22=`  uv = float2(uv.x, -uv.y);
comp_23=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_24=`  uv += float2(0,0) + 0;
comp_25=`  uv *= float2(1,1) * 1;
comp_26=`
comp_27=`  // float2 uv = fragCoord /uv.xy;
comp_28=`
comp_29=`  float3 fianlcol = float3(0.0, 0.0, 0.0);
comp_30=`
comp_31=`  //uv = uv-0.5;
comp_32=`  //uv *= 2.0;
comp_33=`
comp_34=`  //uv.x = uv.x*(uv.x/uv.y);
comp_35=`
comp_36=`  // uv.x -=  (uv.x/uv.y) /2.0 ;
comp_37=`  // uv.y -= 0.5;
comp_38=`
comp_39=`  // uv *=2.;
comp_40=`  float2 uv0= uv;
comp_41=`  for(float i = 0.0;i<2.0;i++)
comp_42=`  {
comp_43=`
comp_44=`    uv = frac(uv);
comp_45=`    uv -=0.5;
comp_46=`    uv*=1.7;
comp_47=`
comp_48=`    float d = length(uv) * exp(-length(uv0)+0.2);
comp_49=`    // (0,1)
comp_50=`    float3   col = palette(length(uv0)+0.3+time*1.3);
comp_51=`    d = sin(d * 2.0+ time*.8 );
comp_52=`    // (-1,1)
comp_53=`
comp_54=`    d = abs(d);
comp_55=`    // (0,1)
comp_56=`    d = smoothstep(0.0,0.4,d);
comp_57=`    d = 0.06/d;
comp_58=`    // (0.1,+00)
comp_59=`    d = clamp(d,sin(time)*.1,1.0);
comp_60=`
comp_61=`    col *=d;
comp_62=`    fianlcol += col*d;
comp_63=`  }
comp_64=`
comp_65=`  fragColor = float4(fianlcol,1.0);
comp_66=`  ret = fragColor;
comp_67=`}
