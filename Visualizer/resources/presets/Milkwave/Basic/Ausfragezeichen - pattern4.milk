bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Ausfragezeichen - pattern4 / https://www.shadertoy.com/view/3lsfRn
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  float2 fragCoord  = uv;
comp_9=`  // CONV: Center on screen, then try some aspect correction
comp_10=`  uv = (uv*2) - 1;
comp_11=`  uv *= aspect.xy;
comp_12=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_13=`  uv = float2(uv.x, -uv.y);
comp_14=`  uv += float2(0.0, 0.0);
comp_15=`  uv *= float2(1.0, 1.0);
comp_16=`
comp_17=`  // constants
comp_18=`  float pi     = 3.14159265359;
comp_19=`  // float piHalf = 1.57079632679;
comp_20=`
comp_21=`  // variables
comp_22=`  float zoom = 4.;
comp_23=`  float speed = 0.125;
comp_24=`  // rotation speed
comp_25=`  float space =3.;
comp_26=`  float radius = 1.;
comp_27=`
comp_28=`  // float2 uv = (fragCoord *2. - uv.xy)/uv.y;
comp_29=`
comp_30=`  uv *= zoom;
comp_31=`
comp_32=`  float2 gv = frac(uv);
comp_33=`
comp_34=`  gv *= space;
comp_35=`  gv -= space/2.;
comp_36=`
comp_37=`  float3 col = float3(0., 0., 0.);
comp_38=`
comp_39=`  float cycle = frac(time * speed);
comp_40=`  // from 0. to 1.
comp_41=`  float alpha = cycle * 2. * pi;
comp_42=`  // alpha in rad from 0 to 2*pi
comp_43=`
comp_44=`  float3 coord3D = float3(gv.x, gv.y, gv.x*gv.y);
comp_45=`  // start with slice at z=0.
comp_46=`  // coord3D = float3();
comp_47=`
comp_48=`  float dist = coord3D.x * coord3D.x + coord3D.y * coord3D.y + coord3D.z * coord3D.z;
comp_49=`  // !? sqrt missing?
comp_50=`
comp_51=`  float c1 = frac(time * speed);
comp_52=`  float a1 = c1 * 2. * pi;
comp_53=`  float f1 = sin(a1+gv.x)-cos(a1+gv.y);
comp_54=`  coord3D.x += uv.x*f1;
comp_55=`  coord3D.y += uv.y*f1;
comp_56=`  coord3D.z *= coord3D.z+f1;
comp_57=`
comp_58=`  float c2 = frac(time * speed * 0.5);
comp_59=`  float a2 = c2 * 2. * pi;
comp_60=`  float f2 = cos(a2+gv.x)+sin(a2+gv.y);
comp_61=`  coord3D.x += uv.x*f2;
comp_62=`  coord3D.y += uv.y*f2;
comp_63=`  coord3D.z += coord3D.z*f2;
comp_64=`
comp_65=`  float lenght3D = length(coord3D);
comp_66=`
comp_67=`  if(lenght3D < radius){
comp_68=`    col = float3(coord3D.x, coord3D.y, coord3D.z);
comp_69=`  }
comp_70=`
comp_71=`  // col += float3(gv, 0.);
comp_72=`  // Output to screen
comp_73=`  fragColor = float4(col,1.0);
comp_74=`  ret = fragColor;
comp_75=`}
