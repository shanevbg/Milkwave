warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// AI - Grid of circles with patterns / https://www.shadertoy.com/view/3dGBWz
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float circle(in float2 st, in float radius){
comp_7=`  float d=length(st-.5);
comp_8=`  return smoothstep(radius,radius-.01,d);
comp_9=`
comp_10=`}
comp_11=`
comp_12=`float generator (in float2 cell,in float mult) {
comp_13=`  float pattern;
comp_14=`  pattern=mult*(sin(cell.x*time/7.)+sin(cell.y*time/7.));
comp_15=`  return frac(pattern);
comp_16=`}
comp_17=`
comp_18=`shader_body {
comp_19=`  float4 fragColor = 0;
comp_20=`  float2 fragCoord = uv;
comp_21=`  // CONV: Center on screen, then try some aspect correction
comp_22=`  uv = (uv*2)  - 1;
comp_23=`  uv *= aspect.xy;
comp_24=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_25=`  uv = float2(uv.x, -uv.y);
comp_26=`
comp_27=`  // float2 uv = fragCoord.xy/uv.xy;
comp_28=`  
comp_29=`  //uv.x*=uv.x/uv.y;
comp_30=`  
comp_31=`  float multiplier=0.8754;
comp_32=`  float Ncircles=12.;
comp_33=`  uv *= Ncircles;
comp_34=`  float2 posInt = floor(uv)+1.;
comp_35=`  // (i,j) integerr coordinates
comp_36=`  float2 posFloat = frac(uv);
comp_37=`  // (u,v) decimal cell coordinates
comp_38=`  float3 color =generator(posInt,multiplier) *float3(1.,.5+.5*cos(time),.5+.5*sin(time));
comp_39=`  color*=circle(posFloat,.5);
comp_40=`  fragColor = float4(color,1.0);
comp_41=`  ret = fragColor;
comp_42=`}
