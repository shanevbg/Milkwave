MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// olee - Lava lamp shader / https://www.shadertoy.com/view/433yD8
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 hsv2rgb(float3 c)
comp_7=`{
comp_8=`  float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
comp_9=`  float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
comp_10=`  return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
comp_11=`}
comp_12=`
comp_13=`shader_body {
comp_14=`  float4 fragColor = 0;
comp_15=`  // CONV: Center on screen, then try some aspect correction
comp_16=`  uv = (uv*2) - 1;
comp_17=`  uv *= aspect.xy;
comp_18=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_19=`  uv = float2(uv.x, -uv.y);
comp_20=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_21=`  uv += float2(0,0) + 0;
comp_22=`  uv *= float2(1,1) * 10;
comp_23=`
comp_24=`  float2 pos[12];
comp_25=`  // compute some swirling points, a uniform may be used instead
comp_26=`  for (int i=0;i<12;i++){
comp_27=`    float f = float(i);
comp_28=`    float tt = sin(f*1000.0)*0.1+0.25;
comp_29=`    float2 r = float2(step(cos(f*10.0),0.0)*2.0-1.0,0.0);
comp_30=`    float y = sin(time*tt+f);
comp_31=`    pos[i] = r*(-cos(time*tt+f)+1.0)*(1.0-y*0.5)+float2(0.0,y)*5.0;
comp_32=`  }
comp_33=`
comp_34=`  // uv in the swirling point space
comp_35=`  // float2 uv = (fragCoord/uv.x)*30.0-float2(15.0,8.0);
comp_36=`  // we will compute 3 separate meta ball distance in the next step
comp_37=`  float3 l = float3(0.0, 0.0, 0.0);
comp_38=`  for (int i=0;i<12;i++){
comp_39=`    float2 d = pos[i]-uv;
comp_40=`    float3 ll = float3(length(d),length(d+float2(0.01,0.0)),length(d+float2(0.0,0.01)));
comp_41=`    // compute the meta ball distance at 3 points
comp_42=`    l += 1.0/(ll*ll+float3(0.1, 0.1, 0.1));
comp_43=`  }
comp_44=`
comp_45=`  // soft clamp the meta ball distances
comp_46=`  l = tanh(l*0.2);
comp_47=`  // estimate the normal from the spatial derivative using the 3 points
comp_48=`  float3 n = normalize(float3(l.y-l.x,l.z-l.x,0.005));
comp_49=`  // estimate the diffuse lighting from the normal
comp_50=`  float d = sqrt(max(-n.y,0.0)+max(n.y*0.25,0.0))*0.04 + 0.96;
comp_51=`  // we use a smooth step function to give a contour for the blobs
comp_52=`  float s = clamp((l.x-0.3)*20.0,0.0,1.0);
comp_53=`  // alternatively a harsh step may be used instead
comp_54=`  // float s = step(0.45,l.x);
comp_55=`  // we use hsv to compute the wax color, a uniform may be used instead
comp_56=`  float3 h = hsv2rgb(float3(frac(time*0.1),1.0,1.0));
comp_57=`  // we use the meta ball distance, normal and color to compute a glow effect
comp_58=`  float3 g = h*l.x*max(-n.y,0.0);
comp_59=`  // we use the diffuse lighting estimation to modulate the color
comp_60=`  // increasing the pow exponent increases the saturation
comp_61=`  // we could use s for the alpha instead of multiplying the color
comp_62=`  // (the glow would obviously not work with that)
comp_63=`  fragColor = float4(lerp(h*d, float3(1.0, 1.0, 1.0), 0.4) * s + g, s);
comp_64=`  // fragColor = float4(,1.0);
comp_65=`  ret = fragColor;
comp_66=`}
