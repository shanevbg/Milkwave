MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Nemix - Blue spiral / https://www.shadertoy.com/view/3sSGWy
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define MAX_TRY_COUNT 110.
comp_7=`#define EPSI .001
comp_8=`#define PI 3.141592
comp_9=`
comp_10=`float sdSphereLines(float3 p, float3 so, float s, float ph){
comp_11=`// so: sphere origin, s = size, ph = phase between 0 and 2Pi
comp_12=`float r = 1.;
comp_13=`p.x += sin(p.z*.1 + ph)*r;
comp_14=`p.y += cos(p.z*.1 + ph)*r;
comp_15=`float zTime = p.z + time;
comp_16=`float m = -1.;
comp_17=`float fl = floor(zTime/m)*m;
comp_18=`s += max(sin(p.z *.1 - time*4.)*.07,0.0);
comp_19=`p.z = zTime - fl;
comp_20=`return length(p- so)-s;
comp_21=`}
comp_22=`
comp_23=`float sdPlane(float3 p, float4 pl){
comp_24=`  p.y += (sin(p.x + time*.5) + cos(p.z + time))*.05;
comp_25=`  return dot(p,pl.xyz) - pl.w;
comp_26=`}
comp_27=`
comp_28=`float map(float3 rp){
comp_29=`  float s1 = sdSphereLines(rp, float3(0., 0., 0.), .01, PI);
comp_30=`  float s2 = sdSphereLines(rp, float3(0., 0., 0.), .01, .0);
comp_31=`  return min(s1,s2);
comp_32=`}
comp_33=`
comp_34=`shader_body {
comp_35=`  float4 fragColor = 0;
comp_36=`  float2 fragCoord  = uv;
comp_37=`  // CONV: Center on screen, then try some aspect correction
comp_38=`  uv = (uv*2) - 1;
comp_39=`  uv *= aspect.xy;
comp_40=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_41=`  uv = float2(uv.x, -uv.y);
comp_42=`  uv += float2(0.0, 0.0);
comp_43=`  uv *= float2(1.0, 1.0)*0.5;
comp_44=`
comp_45=`  // Normalized pixel coordinates (from 0 to 1)
comp_46=`  // float2 uv = fragCoord/uv.xy;
comp_47=`  //uv -= .5;
comp_48=`  //uv.y *= (uv.y/uv.x);
comp_49=`
comp_50=`  // Raymarch
comp_51=`  float3 p = float3(0.,0.,-10.);
comp_52=`  float3 v = normalize(float3(uv.xy, 10.));
comp_53=`  float dist = map(p);
comp_54=`  float acc = 0.;
comp_55=`  for(float i = 0.; i < MAX_TRY_COUNT; i++){
comp_56=`    if(dist < EPSI){
comp_57=`      // CONV: break unsupported, see Milkwave manual
comp_58=`      i = MAX_TRY_COUNT;
comp_59=`      }else{
comp_60=`        p += v*dist;
comp_61=`        dist = map(p);
comp_62=`        acc += dist;
comp_63=`      }
comp_64=`
comp_65=`    }
comp_66=`
comp_67=`    float3 alb = float3(.1,.4,.7);
comp_68=`    float3 col;
comp_69=`    col = alb*(.9-acc*.0002);
comp_70=`    if(dist < EPSI){
comp_71=`      float2 epsAndZero = float2(0.02, 0.);
comp_72=`      float3 normal = float3(
comp_73=`      map(p - epsAndZero.xyy) - map(p + epsAndZero.xyy),
comp_74=`      map(p - epsAndZero.yxy) - map(p + epsAndZero.yxy),
comp_75=`      map(p - epsAndZero.yyx) - map(p + epsAndZero.yyx)
comp_76=`      );
comp_77=`      normal = normalize(normal);
comp_78=`      float3 l = normalize(float3(.0,1.,-1.));
comp_79=`      float diff = max(dot(normal, l),0.);
comp_80=`
comp_81=`      // Blinn
comp_82=`      // float3 r = reflect(l,normal);
comp_83=`      // float spec = pow(max(dot(r, v),0.),16.);
comp_84=`
comp_85=`      // Blinn Phong
comp_86=`      float3 h = normalize(-l+v);
comp_87=`      float spec = pow(max(dot(normal,h),0.),16.);
comp_88=`
comp_89=`      col += spec + diff * alb* .7;
comp_90=`    }
comp_91=`
comp_92=`    // Output to screen
comp_93=`    fragColor = float4(col,1.0);
comp_94=`    ret = fragColor;
comp_95=`  }
