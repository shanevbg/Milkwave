warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// nayk - chat gpt remake / https://www.shadertoy.com/view/4ccfDn
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_14=`  uv += float2(0.5,0.5);
comp_15=`  uv *= float2(1,1) * 1;
comp_16=`
comp_17=`  // Normalized pixel coordinates (from 0 to 1)
comp_18=`  // float2 uv = fragCoord / uv.xy;
comp_19=`
comp_20=`  // Center of the screen
comp_21=`  float2 center = float2(0.5, 0.5);
comp_22=`
comp_23=`  // Time variable for animation
comp_24=`  float t = time;
comp_25=`
comp_26=`  // Number of circles and their size
comp_27=`  float numCircles = 20.0;
comp_28=`  float maxSize = 2.1;
comp_29=`
comp_30=`  // Result color
comp_31=`  float3 resultCol = float3(0.0, 0.0, 0.0);
comp_32=`
comp_33=`  // Loop through the number of circles
comp_34=`  for (float i = 0.0; i < numCircles; i++) {
comp_35=`    // Calculate the angle and radius for each circle
comp_36=`    float angle = (i / numCircles) * 6.28318;
comp_37=`    // 2 * PI
comp_38=`    float radius = maxSize * 0.5 * (1.0 + sin(t + i));
comp_39=`    // Pulsating effect
comp_40=`
comp_41=`    // Position of the circle
comp_42=`    float2 pos = center + radius * float2(cos(angle), sin(angle));
comp_43=`
comp_44=`    // Calculate the distance from the current pixel to the circle's position
comp_45=`    float dist = length(uv - pos);
comp_46=`
comp_47=`    // Color based on the distance and time
comp_48=`    float3 color = float3(0.5 + 0.5 * sin(t + i), 0.5 + 0.5 * cos(t + i), 0.5 + 0.5 * sin(t + i * 2.0));
comp_49=`
comp_50=`    // If the current pixel is within the radius of the circle, add its color
comp_51=`    if (dist < radius) {
comp_52=`      resultCol += color * (1.0 - dist / radius);
comp_53=`      // Fade effect towards the edges
comp_54=`    }
comp_55=`
comp_56=`  }
comp_57=`
comp_58=`  // Output to screen
comp_59=`  fragColor = float4(resultCol, 1.0);
comp_60=`  ret = fragColor;
comp_61=`}
