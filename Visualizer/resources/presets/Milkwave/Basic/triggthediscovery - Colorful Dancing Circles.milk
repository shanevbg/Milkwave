mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// triggthediscovery - Colorful Dancing Circles / https://www.shadertoy.com/view/4clBDH
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`struct Circle {
comp_13=`  float2 cen;
comp_14=`  float dist;
comp_15=`  float offset;
comp_16=`  float speed;
comp_17=`  float begin;
comp_18=`  float end;
comp_19=`  };
comp_20=`
comp_21=`  Circle circles[10];
comp_22=`
comp_23=`  bool cicle_check(float2 uv_conv,  int num) {
comp_24=`    Circle cir = circles[num];
comp_25=`
comp_26=`    float2 cen = cir.cen;
comp_27=`
comp_28=`    cen.x += sin((time+cir.offset)*cir.speed)*cir.dist;
comp_29=`    cen.y +=-cos((time+cir.offset)*cir.speed)*cir.dist;
comp_30=`
comp_31=`    float dist = distance(uv_conv, cen);
comp_32=`
comp_33=`    return dist >= cir.begin && dist <= cir.end;
comp_34=`  }
comp_35=`
comp_36=`  Circle make_circle(float2 center, float dist, float offset, float speed, float begin, float end) {
comp_37=`    Circle ret_cir;
comp_38=`
comp_39=`    ret_cir.cen = center;
comp_40=`    ret_cir.dist = dist;
comp_41=`    ret_cir.offset = offset;
comp_42=`    ret_cir.speed = speed;
comp_43=`    ret_cir.begin = begin;
comp_44=`    ret_cir.end = end;
comp_45=`
comp_46=`    return ret_cir;
comp_47=`  }
comp_48=`
comp_49=`  shader_body {
comp_50=`    float4 fragColor = 0;
comp_51=`    // CONV: Center on screen, then try some aspect correction
comp_52=`    uv = (uv*2) - 1;
comp_53=`    uv *= aspect.xy;
comp_54=`    // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_55=`    uv = float2(uv.x, -uv.y);
comp_56=`    // CONV: Adjust viewpoint (x,y individually or both)
comp_57=`    uv += float2(0,0) + 0.5;
comp_58=`    uv *= float2(1,1) * 1;
comp_59=`
comp_60=`    circles[0] = make_circle(float2(0.0, 0.0), 0.2, 0.0, 1.5, 0.2, 0.25);
comp_61=`    circles[1] = make_circle(float2(0.2, 0.0),0.15, 0.0, 3.0, 0.1, 0.12);
comp_62=`    circles[2] = make_circle(float2(0.0, 0.0), 0.3, 1.6, 1.5, 0.0, 0.3);
comp_63=`    circles[3] = make_circle(float2(-0.4,0.0), 0.3, 1.6, 2.4, 0.35, 0.45);
comp_64=`    circles[4] = make_circle(float2(0.0, 0.2), 0.5, 6.0, 0.5, 0.0, 0.7);
comp_65=`    circles[5] = make_circle(float2(0.0, 0.0), 0.6, 0.0, 0.5, 0.0, 0.7);
comp_66=`
comp_67=`    // Normalized pixel coordinates (from 0 to 1)
comp_68=`    // float2 uv = fragCoord/uv.xy;
comp_69=`
comp_70=`    uv -= float2(0.5,0.5);
comp_71=`    //uv.x *= 1.777;
comp_72=`
comp_73=`    float2 cen = float2(0,0);
comp_74=`
comp_75=`    float dist = distance(uv, cen);
comp_76=`
comp_77=`    float colnum=0.0;
comp_78=`
comp_79=`    for (int i=0; i<6; i++) {
comp_80=`      if (cicle_check(uv, i)) {
comp_81=`        colnum++;
comp_82=`      }
comp_83=`
comp_84=`    }
comp_85=`
comp_86=`    // This will cycle the intersections between red, green and blue.
comp_87=`    float3 col = float3(0,0,1);
comp_88=`
comp_89=`    if (mod_conv(colnum, 3.0) == 1.0) {
comp_90=`      col = float3(1,0,0);
comp_91=`    }
comp_92=`
comp_93=`    else if (mod_conv(colnum, 3.0) == 2.0) {
comp_94=`      col = float3(0,1,0);
comp_95=`    }
comp_96=`
comp_97=`    // Output to screen
comp_98=`    fragColor = float4(col,1.0);
comp_99=`    ret = fragColor;
comp_100=`  }
