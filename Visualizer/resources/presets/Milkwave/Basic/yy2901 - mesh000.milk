mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// yy2901 - mesh000 / https://www.shadertoy.com/view/3tlGzS
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`float2 random2(float2 st){
comp_13=`  st = float2( dot(st,float2(127.1,311.7)),
comp_14=`  dot(st,float2(269.5,183.3)) );
comp_15=`  return -1.0 + 2.0*frac(sin(st)*43758.5453123);
comp_16=`}
comp_17=`
comp_18=`float noise(float2 st) {
comp_19=`  float2 i = floor(st);
comp_20=`  float2 f = frac(st);
comp_21=`
comp_22=`  float2 u = f*f*(3.0-2.0*f);
comp_23=`
comp_24=`  return lerp( lerp( dot( random2(i + float2(0.0,0.0) ), f - float2(0.0,0.0) ),
comp_25=`  dot( random2(i + float2(1.0,0.0) ), f - float2(1.0,0.0) ), u.x),
comp_26=`  lerp( dot( random2(i + float2(0.0,1.0) ), f - float2(0.0,1.0) ),
comp_27=`  dot( random2(i + float2(1.0,1.0) ), f - float2(1.0,1.0) ), u.x), u.y);
comp_28=`}
comp_29=`
comp_30=`shader_body {
comp_31=`  float4 fragColor = 0;
comp_32=`  // CONV: Center on screen, then try some aspect correction
comp_33=`  uv = (uv*2) - 1;
comp_34=`  uv *= aspect.xy;
comp_35=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_36=`  uv = float2(uv.x, -uv.y);
comp_37=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_38=`  uv += float2(0,0) + 0.2;
comp_39=`  uv *= float2(1,1) * 1.2;
comp_40=`//  float2 fragCoord  = uv;
comp_41=`
comp_42=`  // Normalized pixel coordinates (from 0 to 1)
comp_43=`  float2 st = uv; //fragCoord/uv.xy;
comp_44=`
comp_45=`  st-=0.5;
comp_46=`  st.x*=uv*0.75; //uv.x/uv.y;
comp_47=`  st=(1.0-sin(time)*length(st))*st;
comp_48=`
comp_49=`uv = st+0.2*float2(noise(st+time),noise(st.yx+time));
comp_50=`
comp_51=`  // Time varying pixel color
comp_52=`  float3 col;
comp_53=`  col.r = (1.0-smoothstep(length( mod_conv((uv.y+time*0.5)*40.,10.0)-5.0)+0.6,0.2,1.0));
comp_54=`  col.r += (1.0-smoothstep(length( mod_conv((1.7*(uv.x+time*0.1)+uv.y)*25.,10.0)-5.0)+0.6,0.5,1.0));
comp_55=`  col.r += (1.0-smoothstep(length( mod_conv((-1.7*(uv.x-time*0.1)+uv.y)*25.,10.0)-5.0)+0.6,0.5,1.0));
comp_56=`  uv.x+=0.01;
comp_57=`  col.g = 0.9*(1.0-smoothstep(length( mod_conv((uv.y+time*0.5)*40.,10.0)-5.0)+0.6,0.2,1.0));
comp_58=`  col.g += 0.9*(1.0-smoothstep(length( mod_conv((1.7*(uv.x+time*0.1)+uv.y)*25.,10.0)-5.0)+0.6,0.5,1.0));
comp_59=`  col.g += 0.9*(1.0-smoothstep(length( mod_conv((-1.7*(uv.x-time*0.1)+uv.y)*25.,10.0)-5.0)+0.6,0.5,1.0));
comp_60=`  uv.x-=0.01;
comp_61=`  uv.y+=0.01;
comp_62=`  col.b = 0.9*(1.0-smoothstep(length( mod_conv((uv.y+time*0.5)*40.,10.0)-5.0)+0.6,0.2,1.0));
comp_63=`  col.b += 0.9*(1.0-smoothstep(length( mod_conv((1.7*(uv.x+time*0.1)+uv.y)*25.,10.0)-5.0)+0.6,0.5,1.0));
comp_64=`  col.b += 0.9*(1.0-smoothstep(length( mod_conv((-1.7*(uv.x-time*0.1)+uv.y)*25.,10.0)-5.0)+0.6,0.5,1.0));
comp_65=`
comp_66=`  uv = st+0.1*float2(noise(2.0*st-time),noise(2.0*st.yx-time));
comp_67=`  col.r += 0.5*(1.0-smoothstep(length( mod_conv((uv.y-time*0.1)*120.,10.0)-5.0)+0.6,0.2,1.0));
comp_68=`  col.r += 0.5*(1.0-smoothstep(length( mod_conv((1.7*(uv.x-time*0.1)+uv.y)*80.,10.0)-5.0)+0.6,0.5,1.0));
comp_69=`  col.r += 0.5*(1.0-smoothstep(length( mod_conv((-1.7*(uv.x+time*0.1)+uv.y)*80.,10.0)-5.0)+0.6,0.5,1.0));
comp_70=`  // col = float3(1.0-smoothstep(col.r,0.5,0.6));
comp_71=`
comp_72=`  // Output to screen
comp_73=`  fragColor = float4(col,1.0);
comp_74=`  ret = fragColor;
comp_75=`}
