warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// morisil - alien shield / https://www.shadertoy.com/view/3slGRH
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define SCALE 50.0
comp_7=`#define ROTATION_SPEED -1.0
comp_8=`
comp_9=`#define INTENSITY_PULSE_SPEED 1.3
comp_10=`
comp_11=`float getColorComponent(float dist, float angle, float scaleIncrement) {
comp_12=`  return sin(
comp_13=`  (dist * SCALE)
comp_14=`  + angle
comp_15=`  + (cos(dist * SCALE))
comp_16=`  - (time * ROTATION_SPEED)
comp_17=`  )
comp_18=`  - dist * (2.3 + sin(time * INTENSITY_PULSE_SPEED))
comp_19=`  + 0.3;
comp_20=`}
comp_21=`
comp_22=`shader_body {
comp_23=`  float4 fragColor = 0;
comp_24=`  float2 fragCoord = uv;
comp_25=`  // CONV: Center on screen, then try some aspect correction
comp_26=`  uv = (uv*2) - 1;
comp_27=`  uv *= aspect.xy;
comp_28=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_29=`  uv = float2(uv.x, -uv.y);
comp_30=`  uv += float2(0.0, 0.0);
comp_31=`  uv *= float2(1.0, 1.0);
comp_32=`
comp_33=`  // float2 uv = (fragCoord -.5 * uv.xy) / uv.y;
comp_34=`  float dist = length(uv),
comp_35=`  angle = atan2(uv.x, uv.y);
comp_36=`  fragColor = float4(
comp_37=`  getColorComponent(dist, angle, 0.0),
comp_38=`  getColorComponent(dist * 0.99, angle - 0.05, 1.0),
comp_39=`  getColorComponent(dist * 0.98, angle - 0.1, 2.0),
comp_40=`  1.0
comp_41=`  );
comp_42=`  ret = fragColor;
comp_43=`}
