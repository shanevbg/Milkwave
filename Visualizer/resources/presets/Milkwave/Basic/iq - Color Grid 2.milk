MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// iq - Color Grid 2 / https://www.shadertoy.com/view/3tSyW3
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define SHAPE 0
comp_7=`
comp_8=`shader_body {
comp_9=`  float4 fragColor = 0;
comp_10=`  // CONV: Center on screen, then try some aspect correction
comp_11=`  uv = (uv*2) - 1;
comp_12=`  uv *= aspect.xy;
comp_13=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_14=`  uv = float2(uv.x, -uv.y);
comp_15=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_16=`  uv += float2(0,0) + 0;
comp_17=`  uv *= float2(1,1) * 1;
comp_18=`
comp_19=`  float2 fragCoord  = uv;
comp_20=`  float2 p = uv*5; //4.0*(2.0*fragCoord-uv.xy) / uv.y;
comp_21=`
comp_22=`  #if SHAPE==0
comp_23=`  p.x += 0.5*p.y;
comp_24=`  #endif
comp_25=`
comp_26=`  float2 f = frac(p);
comp_27=`  float2 i = floor(p);
comp_28=`
comp_29=`  float id = frac(frac(dot(i,float2(0.436,0.173))) * 45.0);
comp_30=`  #if SHAPE==0
comp_31=`  if( f.x>f.y ) id += 1.3;
comp_32=`  #endif
comp_33=`
comp_34=`  float3  col = 0.5+0.5*cos(0.7*id  + float3(0.0,1.5,2.0) + 4.0);
comp_35=`  float pha = smoothstep(-1.0,1.0,sin(0.2*i.x + 0.2*time + id*1.0));
comp_36=`
comp_37=`  #if SHAPE==0
comp_38=`  float2  pat = min(0.5-abs(f-0.5),abs(f.x-f.y)) - 0.3*pha;
comp_39=`  #else
comp_40=`  float2  pat = 0.5-abs(f-0.5) - 0.5*pha;
comp_41=`  #endif
comp_42=`
comp_43=`  pat = smoothstep( 0.04, 0.07, pat );
comp_44=`
comp_45=`  fragColor = float4( col*pat.x*pat.y, 1.0 );
comp_46=`  ret = fragColor;
comp_47=`}
