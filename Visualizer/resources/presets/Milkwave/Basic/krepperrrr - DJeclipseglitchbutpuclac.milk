MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// krepperrrr - DJeclipseglitchbutpuclac / https://www.shadertoy.com/view/3f33z2
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: setting iChannel samplers to default noise texture
comp_7=`#define iChannel0 sampler_noise_lq
comp_8=`
comp_9=`shader_body {
comp_10=`  float4 fragColor = 0;
comp_11=`  float2 fragCoord = uv;
comp_12=`  // CONV: Center on screen, then try some aspect correction
comp_13=`  uv = (uv*2) - 1;
comp_14=`  uv *= aspect.xy;
comp_15=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_16=`  uv = float2(uv.x, -uv.y);
comp_17=`
comp_18=`  // float2 uv = (fragCoord - 0.5 * uv.xy) / uv.y;
comp_19=`  float time_conv = time;
comp_20=`
comp_21=`  // Calculando el radio para el círculo
comp_22=`  float r = length(uv);
comp_23=`
comp_24=`  // Reacción al sonido con iChannel0
comp_25=`  float beat = tex2D(iChannel0, float2(time_conv * 0.1, 0.5)).r;
comp_26=`  float glitch = sin(time_conv * 10.0 + uv.x * 40.0) * 0.02 + beat * 0.05;
comp_27=`
comp_28=`  // Desplazar la posición UV para crear el glitch
comp_29=`  uv.x += glitch * sin(time_conv * 20.0 + uv.y * 40.0);
comp_30=`
comp_31=`  // Generar el círculo perfecto
comp_32=`  float circle = smoothstep(0.25, 0.26, r);
comp_33=`
comp_34=`  // Gradiente RGB en los costados del círculo
comp_35=`  float3 colorRGB = float3(0.5 + 0.5 * sin(time_conv + r * 6.0),
comp_36=`  0.5 + 0.5 * sin(time_conv + r * 6.0 + 2.0),
comp_37=`  0.5 + 0.5 * sin(time_conv + r * 6.0 + 4.0));
comp_38=`
comp_39=`  // Intensificar el color en el círculo
comp_40=`  float3 finalColor = colorRGB * (1.0 - r);
comp_41=`  // La intensidad aumenta hacia el centro
comp_42=`
comp_43=`  // Agregar glitch y ajuste de brillo
comp_44=`  float flicker = 0.8 + 0.2 * frac(sin(dot(fragCoord.xy, float2(12.9898, 78.233))) * 43758.5453 + time_conv * 5.0);
comp_45=`
comp_46=`  // Color final, combinando el círculo con el gradiente RGB
comp_47=`  fragColor = float4(finalColor * circle * flicker, 1.0);
comp_48=`  ret = fragColor;
comp_49=`}
