warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Plento - Party Hat Paradise / https://www.shadertoy.com/view/3s3BDN
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define R uv
comp_7=`
comp_8=`shader_body {
comp_9=`  float4 f = 0;
comp_10=`  float2 u  = uv;
comp_11=`  // CONV: Center on screen, then try some aspect correction
comp_12=`  uv = (uv*2) - 1;
comp_13=`  uv *= aspect.xy;
comp_14=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_15=`  uv = float2(uv.x, -uv.y);
comp_16=`  uv += float2(0.0, 0.0);
comp_17=`  uv *= float2(1.0, 1.0);
comp_18=`
comp_19=`  // float2 uv = float2(u.xy - 0.5*R.xy)/R.y;
comp_20=`
comp_21=`  float3 col = float3(0, 0, 0);
comp_22=`
comp_23=`  float r = .5;
comp_24=`  float n = 20.;
comp_25=`
comp_26=`  for(float i = 0.; i < n; i++)
comp_27=`  {
comp_28=`    uv.y += sin(i*0.5 + time*4.)*0.01;
comp_29=`    uv.x += cos(i*0.5 + time*4.)*0.01;
comp_30=`
comp_31=`    float2 ruv = frac(uv*2.)-.5;
comp_32=`    float2 id = floor(uv*2.);
comp_33=`
comp_34=`    float3 nc = .8+.5*cos(float3(2.,3.,0.4)*(id.x+id.y+i*48.)*4.);
comp_35=`    nc *= (i+0.7) / n;
comp_36=`
comp_37=`    col = lerp(col, nc, smoothstep(r, r - .015, length(ruv)));
comp_38=`
comp_39=`    uv *= 1.04;
comp_40=`    r -= 0.023;
comp_41=`  }
comp_42=`
comp_43=`  col *= ((1.-abs(uv.x*.3)) * (1.-abs(uv.y*.3)))*1.1;
comp_44=`  f = float4(col,1.0);
comp_45=`  ret = f;
comp_46=`}
