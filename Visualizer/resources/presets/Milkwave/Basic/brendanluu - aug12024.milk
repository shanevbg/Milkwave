MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// brendanluu - aug12024 / https://www.shadertoy.com/view/4cSyRV
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette(float t) {
comp_7=`  float3 a = float3(1.000,0.000,0.733);
comp_8=`  float3 b = float3(0.333,0.169,0.263);
comp_9=`  float3 c = float3(0.310,0.012,0.216);
comp_10=`  float3 d = float3(0.416,0.165,0.165);
comp_11=`
comp_12=`  return a + b*cos(6.28318*(c*t-d) );
comp_13=`}
comp_14=`
comp_15=`float vignette(float2 uv_conv,  float radius, float softness) {
comp_16=`  float d = length(uv_conv);
comp_17=`  float v = smoothstep(radius, radius - softness, d);
comp_18=`  return v;
comp_19=`}
comp_20=`
comp_21=`float random(float2 st) {
comp_22=`  return frac(sin(dot(st.xy, float2(12.9898,78.233))) * 43758.5453123);
comp_23=`}
comp_24=`
comp_25=`float2 hash( float2 p ) {
comp_26=`  p = float2( dot(p,float2(127.1,311.7)), dot(p,float2(269.5,183.3)) );
comp_27=`  return -1.0 + 2.0*frac(sin(p)*43758.5453123);
comp_28=`}
comp_29=`
comp_30=`float noise(float2 p) {
comp_31=`  const float K1 = 0.366025404;
comp_32=`  const float K2 = 0.211324865;
comp_33=`
comp_34=`  float2 i = floor(p + (p.x+p.y)*K1);
comp_35=`  float2 a = p - i + (i.x+i.y)*K2;
comp_36=`  float2 o = (a.x>a.y) ? float2(1.0,0.0) : float2(0.0,1.0);
comp_37=`  float2 b = a - o + K2;
comp_38=`  float2 c = a - 1.0 + 2.0*K2;
comp_39=`
comp_40=`  float3 h = max(0.5-float3(dot(a,a), dot(b,b), dot(c,c)), 0.0);
comp_41=`
comp_42=`  float3 n = h*h*h*h*float3(dot(a,hash(i+0.0)), dot(b,hash(i+o)), dot(c,hash(i+1.0)));
comp_43=`
comp_44=`  return dot(n, float3(70.0, 70.0, 70.0));
comp_45=`}
comp_46=`
comp_47=`shader_body {
comp_48=`  float4 fragColor = 0;
comp_49=`  // CONV: Center on screen, then try some aspect correction
comp_50=`  uv = (uv*2) - 1;
comp_51=`  uv *= aspect.xy;
comp_52=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_53=`  uv = float2(uv.x, -uv.y);
comp_54=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_55=`  uv += float2(0,0) + 0;
comp_56=`  uv *= float2(1,1) * 1.5;
comp_57=`
comp_58=`  // float2 uv = fragCoord / uv.xy * 2.0 - 1.0;
comp_59=`  //uv.x *= uv.x / uv.y;
comp_60=`
comp_61=`  float3 backgroundColor = float3(0.702,0.702,0.702);
comp_62=`  // Green background
comp_63=`  float3 finalColor = backgroundColor;
comp_64=`
comp_65=`  // Create droplet effect
comp_66=`  float dropletScale = 1.1;
comp_67=`  float2 dropletUV = uv * dropletScale;
comp_68=`  float2 id = floor(dropletUV);
comp_69=`  float2 gv = frac(dropletUV) - 0.5;
comp_70=`
comp_71=`  for (float y = -2.0; y <= 2.0; y++) {
comp_72=`    for (float x = -2.0; x <= 2.0; x++) {
comp_73=`      float2 offset = float2(x, y);
comp_74=`      float2 n = hash(id + offset);
comp_75=`      float2 p = offset + sin(n * time) * 0.5;
comp_76=`      float d = length(gv - p);
comp_77=`
comp_78=`      float rippleSpeed = .3;
comp_79=`      float rippleStrength = 9.9;
comp_80=`      float r = smoothstep(1.3, 0.2, d);
comp_81=`      r *= 4.0 + sin(time * rippleSpeed + noise(id + offset) * 1000.0) * rippleStrength;
comp_82=`
comp_83=`      if (d < r) {
comp_84=`        float2 dropUV = (gv - p) / r + 0.5;
comp_85=`        dropUV = dropUV * 1.0 - 1.0;
comp_86=`
comp_87=`        float dropD = length(dropUV);
comp_88=`        float3 col = palette(time / 3.0 + noise(id + offset));
comp_89=`        dropD = sin(dropD * 3.0 + (time + noise(id + offset) * 5.0) / 4.0) / 8.0;
comp_90=`        dropD = abs(dropD);
comp_91=`        dropD = 0.1 / dropD;
comp_92=`        finalColor = lerp(finalColor, col * dropD * 2.0, r);
comp_93=`      }
comp_94=`
comp_95=`    }
comp_96=`
comp_97=`  }
comp_98=`
comp_99=`  fragColor = float4(finalColor, 1.0);
comp_100=`  ret = fragColor;
comp_101=`}
