mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// reitermoises - ColorShader_0005 / https://www.shadertoy.com/view/4cK3Rt
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette( float t ) {
comp_7=`  float3 a = float3(0.369,0.369,0.369);
comp_8=`  float3 b = float3(0.000,0.761,0.051);
comp_9=`  float3 c = float3(0.000,0.298,1.000);
comp_10=`  float3 d = float3(1.000,1.000,1.000);
comp_11=`
comp_12=`  return a + b*cos( 6.28318*(c*t+d) );
comp_13=`}
comp_14=`
comp_15=`shader_body {
comp_16=`  float4 fragColor = 0;
comp_17=`  float2 fragCoord  = uv;
comp_18=`  // CONV: Center on screen, then try some aspect correction
comp_19=`  uv = (uv*2) - 1;
comp_20=`  uv *= aspect.xy;
comp_21=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_22=`  uv = float2(uv.x, -uv.y);
comp_23=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_24=`  uv += float2(0,0) + 0;
comp_25=`  uv *= float2(1,1) * 1;
comp_26=`
comp_27=`  // convertimos el valos normalizado de las coordenadas de pantalla -1 a 1
comp_28=`  // float2 uv = (fragCoord * 2.0 - uv.xy) / uv.y;
comp_29=`
comp_30=`  // vector que rastre pixel por pixel
comp_31=`  float2 uv0 = uv;
comp_32=`
comp_33=`  // color final
comp_34=`  float3 finalColor = float3(0.0, 0.0, 0.0);
comp_35=`
comp_36=`  // agregamos iteraciones
comp_37=`  for(float i = 0.0; i < 6.0; i++){
comp_38=`
comp_39=`    // agregamos repeticion espacial (division de pantalla) y ajsutamos las coordenadas
comp_40=`    uv = frac(uv * 3.5) - 0.5;
comp_41=`
comp_42=`    // creamos una variable para ver la longitud del uv
comp_43=`    float d = length(uv) * -exp(-length(uv0));
comp_44=`
comp_45=`    // agregamos una variable de color
comp_46=`    float3 col = palette(length(uv0) + i * 0.4 + time * .1);
comp_47=`
comp_48=`    // al agregar sin y un tiempo podemos crear una animacion de repetecion
comp_49=`    d = sin(d*8. + time)/8.;
comp_50=`
comp_51=`    // obtenemos el valor absoluto de d
comp_52=`    d = abs(d);
comp_53=`
comp_54=`    d = pow(0.012 / d, 1.2) * i;
comp_55=`
comp_56=`    // agregamos el color a la longitud
comp_57=`    finalColor += col * d;
comp_58=`  }
comp_59=`
comp_60=`  // salida a la pantalla
comp_61=`  fragColor = float4(finalColor, 1.0);
comp_62=`  ret = fragColor;
comp_63=`}
