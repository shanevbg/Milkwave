warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// spenceryonce - Multibrot Fractal V2 / https://www.shadertoy.com/view/433Sz2
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define MAX_ITER 512.0
comp_7=`#define B MAX_ITER/2.0
comp_8=`
comp_9=`void multibrot(float2 c, float2 z, out float3 color, float d) {
comp_10=`  float iter = 0.0;
comp_11=`  for(; iter < MAX_ITER; iter++) {
comp_12=`    float r = length(z);
comp_13=`    float theta = atan2(z.y, z.x);
comp_14=`    z = pow(r, d) * float2(cos(d * theta), sin(d * theta)) + c;
comp_15=`    if (dot(z,z) > (B*B)) {
comp_16=`      // CONV: replaced break with breaking condition
comp_17=`      iter = MAX_ITER;
comp_18=`    }
comp_19=`
comp_20=`  }
comp_21=`
comp_22=`  if(iter > MAX_ITER-1.0) {color = float3(0.0, 0.0, 0.0);}
comp_23=`  float s = iter - log(log(length(z))/log(B))/log(2.0);
comp_24=`  color = 0.5 + 0.5*cos( 3.0 + s*0.16 + float3(0.000,1.000,0.882));
comp_25=`
comp_26=`}
comp_27=`
comp_28=`shader_body {
comp_29=`  float4 O = 0;
comp_30=`  // CONV: Center on screen, then try some aspect correction
comp_31=`  uv = (uv*2) - 1;
comp_32=`  uv *= aspect.xy;
comp_33=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_34=`  uv = float2(uv.x, -uv.y);
comp_35=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_36=`  uv += float2(0,0) + 0.25;
comp_37=`  uv *= float2(1,1) * 1.25;
comp_38=`
comp_39=`  //float2 fc = uv;
comp_40=`  //fc = (2.0*uv)/uv;
comp_41=`
comp_42=`  float3 col = float3(1.0, 0.0, 0.0);
comp_43=`  float2 z = float2(0.0001,0.0001);
comp_44=`  float2 zoomP = float2(0.392003,-0.267125);
comp_45=`  float zoom = 0.62 + 0.38*cos(.07*time);
comp_46=`  float d = 2.0;
comp_47=`  zoom = pow(zoom, 8.0);
comp_48=`  multibrot(zoomP+uv*zoom, z, col, d);
comp_49=`  col = pow(col,float3(0.4545, 0.4545, 0.4545));
comp_50=`  O = float4(col, 1.0);
comp_51=`  ret = O;
comp_52=`}
