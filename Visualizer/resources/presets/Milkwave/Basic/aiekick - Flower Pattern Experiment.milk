warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// aiekick - Flower Pattern Experiment / https://www.shadertoy.com/view/3sBXRm
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  float2 fragCoord  = uv;
comp_9=`  // CONV: Center on screen, then try some aspect correction
comp_10=`  uv = (uv*2) - 1;
comp_11=`  uv *= aspect.xy;
comp_12=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_13=`  uv = float2(uv.x, -uv.y);
comp_14=`  uv += float2(0.0, 0.0);
comp_15=`  uv *= float2(1.0, 1.0);
comp_16=`
comp_17=`  // float2 uv = (fragCoord*2.-uv.xy)/min(uv.x, uv.y) * 2.;
comp_18=`  float2 uva = float2(atan2(uv.x, uv.y), length(uv)*5.);
comp_19=`  float n = 5.;
comp_20=`  if (mouse.z > 0.)
comp_21=`  n = floor(mouse.x/uv.x * 20.) - 10.;
comp_22=`  float t = time+10;
comp_23=`  float st = 0.2;
comp_24=`  if (mouse.z > 0.)
comp_25=`  st = mouse.y/uv.y;
comp_26=`  uva.x += uva.y * st;
comp_27=`  float lim = lerp(1., 20., sin(t * 0.2) * 0.5 + 0.5);
comp_28=`  uva.y *= smoothstep(uva.y-lim, uva.y, sin(uva.x * floor(n))*0.5+0.5);
comp_29=`  uva.x /= 6.28318 / n;
comp_30=`  uva = abs(frac(uva)-0.5);
comp_31=`  uva.y += 0.5;
comp_32=`  fragColor.x = 1.4-max(abs(uva.x)+uva.y,-uva.y);
comp_33=`  fragColor.y = 1.4-length(uva);
comp_34=`  fragColor.z =  1.4-max(abs(uva.x),abs(uva.y));
comp_35=`  fragColor.w = 1.0;
comp_36=`  ret = fragColor;
comp_37=`}
