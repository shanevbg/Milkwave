mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Xe_non - Inverse ripples / https://www.shadertoy.com/view/4cXcW8
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette(float t) {
comp_7=`  return float3(t, 0.1, 0.3);
comp_8=`}
comp_9=`
comp_10=`shader_body {
comp_11=`  float4 fragColor = 0;
comp_12=`  // CONV: Center on screen, then try some aspect correction
comp_13=`  uv = (uv*2) - 1;
comp_14=`  uv *= aspect.xy;
comp_15=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_16=`  uv = float2(uv.x, -uv.y);
comp_17=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_18=`  uv += float2(0,0) + 0;
comp_19=`  uv *= float2(1,1) * 2;
comp_20=`
comp_21=`  // float2 uv = fragCoord / uv.xy; // Normalization
comp_22=`
comp_23=`  //uv = uv * 2.0 - 1.0;
comp_24=`  // Centering coords
comp_25=`  //  uv.x *= uv.x / uv.y;
comp_26=`  // Correcting aspect ratio
comp_27=`
comp_28=`  float gridSize = 10.0;
comp_29=`  // Set grid size
comp_30=`
comp_31=`  float2 gridPos = floor(uv * gridSize) / gridSize;
comp_32=`  // Calculate points position
comp_33=`
comp_34=`  float angle = time * 2.5 + length(gridPos) * 7.0;
comp_35=`  // Calculate movement offset
comp_36=`  float2 offset = float2(cos(angle), sin(angle)) * 0.1;
comp_37=`
comp_38=`  float2 pointPos = gridPos + offset / gridSize;
comp_39=`  // Place points with offset
comp_40=`
comp_41=`  float dist = length(uv - pointPos);
comp_42=`  // Distance from (0, 0)
comp_43=`
comp_44=`  float intensity = smoothstep(0.02, 0.01, dist);
comp_45=`  // Smoothen the points
comp_46=`
comp_47=`  float3 color = palette(intensity);
comp_48=`  // Color palette
comp_49=`
comp_50=`  fragColor = float4(color, 1.0);
comp_51=`  // Ser fragment color
comp_52=`  ret = fragColor;
comp_53=`}
