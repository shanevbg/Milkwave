MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// adiron - dat whirly / https://www.shadertoy.com/view/3fj3zd
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`#define PI 3.14159
comp_13=`#define TWO_PI (PI * 2.0)
comp_14=`#define RAY_COUNT 7.0
comp_15=`#define RAY_WIDTH radians(40.0)
comp_16=`#define SMOOTHING 0.2
comp_17=`#define SPIN_SPEED 0.75
comp_18=`#define COS_PERIOD 4.0
comp_19=`#define COS_DAMPEN 2.0
comp_20=`#define ZOOM_SPEED -70.0
comp_21=`
comp_22=`float3 palette( in float t, in float3 a, in float3 b, in float3 c, in float3 d )
comp_23=`{
comp_24=`  return a + b*cos( 6.283185*(c*t+d) );
comp_25=`}
comp_26=`
comp_27=`shader_body {
comp_28=`  float4 fragColor = 0;
comp_29=`  // CONV: Center on screen, then try some aspect correction
comp_30=`  uv = (uv*2) - 1;
comp_31=`  uv *= aspect.xy;
comp_32=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_33=`  uv = float2(uv.x, -uv.y);
comp_34=`
comp_35=`  // Normalized pixel coordinates (from 0 to 1)
comp_36=`  // float2 uv = fragCoord/uv.xy;
comp_37=`  float aspect = uv.x/uv.y;
comp_38=`  float2 fragCoord  = uv;
comp_39=`
comp_40=`  float theta = atan2(uv.x, uv.y);
comp_41=`  float l = length(uv);
comp_42=`  // Warp the rays
comp_43=`  float warpAmount = sin((l * COS_PERIOD + time/2.0) * time/ZOOM_SPEED) / COS_DAMPEN;
comp_44=`  theta += warpAmount;
comp_45=`  // Overall spin speed
comp_46=`  theta -= time * SPIN_SPEED;
comp_47=`  float3 col = float3(0.0, 0.0, 0.0);
comp_48=`  float rayPhase = mod_conv(theta, TWO_PI/RAY_COUNT);
comp_49=`
comp_50=`  // This finds the pixel's current location and whether it's in a ray or not.
comp_51=`  float rayNorm = rayPhase / RAY_WIDTH;
comp_52=`  float raySmoothed = smoothstep(0.0, SMOOTHING, rayNorm)-smoothstep(1.0 - SMOOTHING, 1.0, rayNorm);
comp_53=`  col = float3(
comp_54=`  palette(
comp_55=`  raySmoothed,
comp_56=`  float3(0.568, 0.658, 1.048),
comp_57=`  float3(1.838, 0.298, 0.396),
comp_58=`  float3(0.138, 0.528, 0.142),
comp_59=`  float3(0.688, 2.445, 1.150)
comp_60=`  )
comp_61=`  );
comp_62=`
comp_63=`  // Output to screen
comp_64=`  fragColor = float4(col, 1.0);
comp_65=`  ret = fragColor;
comp_66=`}
