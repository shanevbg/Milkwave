b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// smit3131 - Glowing Orb of Light / https://www.shadertoy.com/view/43jfzV
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_14=`  uv += float2(0,0) + 0;
comp_15=`  uv *= float2(1,1) * 1;
comp_16=`
comp_17=`  // Normalize fragment coordinates
comp_18=`  // float2 uv = fragCoord / uv.xy;
comp_19=`  //uv = uv * 2.0 - 1.0;
comp_20=`  //uv.x *= uv.x / uv.y;
comp_21=`  // Aspect ratio correction
comp_22=`
comp_23=`  // Animated light position (rotating around the center)
comp_24=`  float t = time * 0.5;
comp_25=`  // Time-based animation speed
comp_26=`  float3 lightPos = float3(sin(t), cos(t), 1.5);
comp_27=`  // Moving light position
comp_28=`
comp_29=`  // Surface normal at each point (simplified sphere shape)
comp_30=`  float3 normal = normalize(float3(uv, 1.0));
comp_31=`
comp_32=`  // View direction (camera looking towards the center)
comp_33=`  float3 viewDir = normalize(float3(0.0, 0.0, 1.0));
comp_34=`
comp_35=`  // Gradient background
comp_36=`  float3 backgroundColor = lerp(float3(0.1, 0.1, 0.3), float3(0.9, 0.3, 0.5), uv.y * 0.5 + 0.5);
comp_37=`
comp_38=`  // Lighting calculations
comp_39=`  float3 lightDir = normalize(lightPos - normal);
comp_40=`  float diffuse = max(dot(lightDir, normal), 0.0);
comp_41=`
comp_42=`  // Animated color palette for the object
comp_43=`  float3 baseColor = float3(0.5 + 0.5 * sin(time), 0.5 + 0.5 * cos(time * 0.7), 0.7);
comp_44=`
comp_45=`  // Diffuse lighting (color influenced by light direction)
comp_46=`  float3 diffuseColor = diffuse * baseColor;
comp_47=`
comp_48=`  // Specular highlight (shiny effect)
comp_49=`  float3 reflectDir = reflect(-lightDir, normal);
comp_50=`  float specular = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
comp_51=`  // Shiny factor
comp_52=`  float3 specularColor = specular * float3(1.0, 1.0, 1.0);
comp_53=`  // White highlight
comp_54=`
comp_55=`  // Fresnel effect (edge glow)
comp_56=`  float fresnel = pow(1.0 - max(dot(viewDir, normal), 0.0), 3.0);
comp_57=`  float3 fresnelColor = fresnel * float3(0.8, 0.9, 1.0);
comp_58=`  // Light blue glow at edges
comp_59=`
comp_60=`  // Final color combining all effects
comp_61=`  float3 color = backgroundColor + diffuseColor + specularColor + fresnelColor;
comp_62=`
comp_63=`  // Apply soft glow using exponential falloff for a smooth finish
comp_64=`  float glow = exp(-length(uv) * 3.0);
comp_65=`  color += glow * float3(0.3, 0.5, 0.9);
comp_66=`  // Add soft glow effect
comp_67=`
comp_68=`  // Output final color
comp_69=`  fragColor = float4(color, 1.0);
comp_70=`  ret = fragColor;
comp_71=`}
