warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// Del - neontest1 / https://www.shadertoy.com/view/3scGDX
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define PI 3.1415926
comp_7=`
comp_8=`float pat(float2 uv_conv, float p,float q,float s,float glow)
comp_9=`{
comp_10=`  q += (0.5+sin(time*s)*0.5);
comp_11=`  float z = cos(q * PI * uv_conv.x) * cos(p * PI * uv_conv.y) + cos(q * PI * uv_conv.y) * cos(p * PI * uv_conv.x);
comp_12=`  float dist=abs(z)*(1.0/glow);
comp_13=`  return dist;
comp_14=`}
comp_15=`
comp_16=`shader_body {
comp_17=`  float4 fragColor = 0;
comp_18=`  float2 fragCoord  = uv;
comp_19=`  // CONV: Center on screen, then try some aspect correction
comp_20=`  uv = (uv*2) - 1;
comp_21=`  uv *= aspect.xy;
comp_22=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_23=`  uv = float2(uv.x, -uv.y);
comp_24=`  uv += float2(0.0, 0.0);
comp_25=`  uv *= float2(1.0, 1.0);
comp_26=`
comp_27=`  // float2 uv = (fragCoord.xy - 0.5 * uv.xy) / uv.y;
comp_28=`  float d = pat(uv, 5.0, 2.0, 1.0, 0.35);
comp_29=`  // layer1
comp_30=`  if (mouse.z>0.5)
comp_31=`  d *= pat(uv, 3.0, 7.0, 0.25, 0.45);
comp_32=`  // layer2
comp_33=`
comp_34=`  float3 col = float3(0.5,1.1,0.4)*0.5/d;
comp_35=`  fragColor = float4(col,1.0);
comp_36=`  ret = fragColor;
comp_37=`}
