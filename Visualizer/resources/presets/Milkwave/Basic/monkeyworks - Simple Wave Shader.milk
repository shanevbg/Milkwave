b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// monkeyworks - Simple Wave Shader / https://www.shadertoy.com/view/43XcRr
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette(float t) {
comp_7=`  float3 a = float3(0.5, 0.5, 0.5);
comp_8=`  float3 b = float3(0.5, 0.5, 0.5);
comp_9=`  float3 c = float3(1.0, 1.0, 1.0);
comp_10=`  float3 d = float3(0.263, 0.416, 0.557);
comp_11=`  return a + b * cos(6.28318 * (c * t + d));
comp_12=`}
comp_13=`
comp_14=`shader_body {
comp_15=`  float4 fragColor = 0;
comp_16=`  float2 fragCoord = uv;
comp_17=`  // CONV: Center on screen, then try some aspect correction
comp_18=`  uv = (uv*2) - 1;
comp_19=`  uv *= aspect.xy;
comp_20=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_21=`  uv = float2(uv.x, -uv.y);
comp_22=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_23=`  uv += float2(0,0) + 0;
comp_24=`  uv *= float2(1,1) * 1;
comp_25=`
comp_26=`  float2 resolution = uv.xy;
comp_27=`  float time_conv = time * 0.5;
comp_28=`  // Slowed down the time_conv factor
comp_29=`  float2 pointer = mouse.xy / resolution;
comp_30=`
comp_31=`  // float2 uv = (fragCoord.xy * 2.0 - resolution.xy) / resolution.y;
comp_32=`  float2 uv0 = uv;
comp_33=`  float3 finalColor = float3(0.0, 0.0, 0.0);
comp_34=`
comp_35=`  // Removed the fract function to eliminate tiling
comp_36=`  uv = sin(uv * 0.5 - time_conv * 0.2) * 0.5;
comp_37=`  // Adjusted scale and added time-based movement
comp_38=`  //uv -= pointer * 2.0 - 1.0;
comp_39=`  // Adjusted pointer influence
comp_40=`
comp_41=`  float d = length(uv) * exp(-length(uv0));
comp_42=`  float3 col = palette(length(uv0) + time_conv * 0.4);
comp_43=`  d = sin(d * 4.0 + time) / 4.0;
comp_44=`  // Reduced frequency for smoother waves
comp_45=`  d = abs(d);
comp_46=`  d = pow(0.05 / d, 1.5);
comp_47=`  // Adjusted power for softer edges
comp_48=`  finalColor += col * d;
comp_49=`
comp_50=`  // Add a subtle glow
comp_51=`  finalColor += col * 0.1 * smoothstep(0.5, 0.0, length(uv0));
comp_52=`
comp_53=`  fragColor = float4(finalColor, 1.0);
comp_54=`  ret = fragColor;
comp_55=`}
