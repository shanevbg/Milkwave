warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// makesmi - orange planet / https://www.shadertoy.com/view/3slcDn
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  // CONV: Center on screen, then try some aspect correction
comp_9=`  uv = (uv*2) - 1;
comp_10=`  uv *= aspect.xy;
comp_11=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_12=`  uv = float2(uv.x, -uv.y);
comp_13=`  uv += float2(0,0);
comp_14=`  uv *= float2(1,1)*1.8;
comp_15=`  float2 fragCoord  = uv;
comp_16=`
comp_17=`  float2 pixel = uv; //(fragCoord-0.5*uv.xy)/uv.y*2.0;
comp_18=`  float time_conv = time + 26.0;
comp_19=`  float squareSum = dot(pixel, pixel);
comp_20=`  float d = (8. - sqrt(16. - squareSum*20.)) / (squareSum + 4.);
comp_21=`  float isSphere = step(0.0, d);
comp_22=`  float3 worldPosition = float3(d * pixel.xy, d*2. - 4.);
comp_23=`
comp_24=`  float sum = 0.;
comp_25=`  for(float i = 0.; i < 22.; i++){
comp_26=`    float angle1 = 2. * cos(i + 0.2 + time_conv*0.11) + 3. * sin(i * 5.7 + 5.);
comp_27=`    float angle2 = sin(i*3.5 + 3. + time_conv*0.4) + 2. * sin(i * 1.4 + 1.);
comp_28=`    float3 direction = float3(cos(angle1)*sin(angle2), cos(angle2), sin(angle1)+cos(angle2*1.5));
comp_29=`    float3 distance = normalize(worldPosition) - normalize(direction);
comp_30=`    sum += 1.0 / dot(distance, distance);
comp_31=`  }
comp_32=`
comp_33=`  float outer = smoothstep(7.5, 6.0, abs(sum - 39.0));
comp_34=`  float inner = smoothstep(16.0, 10.0, abs(sum - 105.));
comp_35=`  float strong = outer + inner;
comp_36=`  float fadeout = 1.-smoothstep(-0.5, -1.6, worldPosition.z);
comp_37=`  float smoothing = smoothstep(-0.75, -1.0, worldPosition.z);
comp_38=`  float color = min(isSphere, (fadeout+max(strong, 0.13))*smoothing);
comp_39=`  fragColor = float4(1.,1.-color*0.5,1.-color, 1.0);
comp_40=`  ret = fragColor;
comp_41=`}
