MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// klk - Fl_ow / https://www.shadertoy.com/view/3ljGzd
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define PI 3.141592654
comp_7=`
comp_8=`float wave(float x)
comp_9=`{
comp_10=`  float s=sin(x);
comp_11=`  return s*abs(s);
comp_12=`}
comp_13=`
comp_14=`shader_body {
comp_15=`  float4 fragColor = 0;
comp_16=`  float2 fragCoord  = uv;
comp_17=`  // CONV: Center on screen, then try some aspect correction
comp_18=`  uv = (uv*2) - 1;
comp_19=`  uv *= aspect.xy;
comp_20=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_21=`  uv = float2(uv.x, -uv.y);
comp_22=`
comp_23=`  // float2 uv = (fragCoord-uv.xy*.5)/uv.yy*2.;
comp_24=`  float a=(atan2(uv.x,uv.y)/2./PI)+.5;
comp_25=`  float l=length(uv);
comp_26=`  float w=0.1/(1.+l);
comp_27=`  /*
comp_28=`  a=uv.x*0.15;
comp_29=`  l=uv.y*0.2+.4;
comp_30=`  w=0.05;
comp_31=`  */
comp_32=`  l*=(1.+w*wave(a*10.*PI));
comp_33=`  a+=w*wave(l*1.1*PI)-time*0.05;
comp_34=`  l*=(1.+w*wave(a*14.*PI));
comp_35=`  a+=w*wave(l*2.6*PI)+time*0.075;
comp_36=`  l*=(1.+w*wave(a*12.*PI));
comp_37=`  a+=w*wave(l*4.1*PI)-time*0.035;
comp_38=`  l*=(1.+w*wave(a*8.*PI));
comp_39=`  a+=w*wave(l*5.6*PI)+time*0.045;
comp_40=`
comp_41=`  float r=a*12.+l-time*.2;
comp_42=`  float g=l*3.+a+time*.3;
comp_43=`  float b=-a*6.+l*2.+time*.25;
comp_44=`
comp_45=`  float3 c=float3(
comp_46=`  frac(r)>.5?0.:1.,
comp_47=`  frac(g)>.5?0.:1.,
comp_48=`  frac(b)>.5?0.:1.
comp_49=`  );
comp_50=`
comp_51=`  if(mouse.z<0.1)
comp_52=`  c=(float3(
comp_53=`  sin(r*2.*PI),
comp_54=`  sin(g*2.*PI),
comp_55=`  sin(b*2.*PI)
comp_56=`  )+1.)*0.5;
comp_57=`
comp_58=`  c=lerp(float3(.7,.9,1),float3(.2,.5,1),sqrt(dot(c,c)))*(1.2-c*.2);
comp_59=`
comp_60=`  fragColor = float4(c,1);
comp_61=`  ret = fragColor;
comp_62=`}
