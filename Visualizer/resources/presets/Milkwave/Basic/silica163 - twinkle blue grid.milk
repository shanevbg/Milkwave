warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// silica163 - twinkle blue grid / https://www.shadertoy.com/view/43SyDh
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`// CONV: adding helper functions
comp_7=`float mod_conv(float x, float y) { return x - y * floor(x / y); }
comp_8=`float2 mod_conv(float2 x, float2 y) { return x - y * floor(x / y); }
comp_9=`float3 mod_conv(float3 x, float3 y) { return x - y * floor(x / y); }
comp_10=`float4 mod_conv(float4 x, float4 y) { return x - y * floor(x / y); }
comp_11=`
comp_12=`float rand(float2 p){
comp_13=`  float v = frac(8951.9201*sin(dot(p,float2(0.1031,0.0031))));
comp_14=`  return v;
comp_15=`}
comp_16=`
comp_17=`float4 cubicBezier(float t, float4 a, float4 b, float4 c, float4 d){
comp_18=`  float r = 1.-t;
comp_19=`  float r2 = r*r;
comp_20=`  float r3 = r*r*r;
comp_21=`  float t2 = t*t;
comp_22=`  float t3 = t*t*t;
comp_23=`
comp_24=`  return r3*a + 3.*t*r2*b + 3.*t2*r*c + t3*d;
comp_25=`}
comp_26=`
comp_27=`float4 cubicSpline(float t, float4 a, float4 b, float4 c, float4 d){
comp_28=`  float4 ca = c - a;
comp_29=`  float4 db = d - b;
comp_30=`
comp_31=`  float r = 1.-t;
comp_32=`  float r2 = r*r;
comp_33=`  float r3 = r*r*r;
comp_34=`  float t2 = t*t;
comp_35=`  float t3 = t*t*t;
comp_36=`  return
comp_37=`  // V
comp_38=`  r3*b +
comp_39=`  t*r2*(b + ca) +
comp_40=`  // t*r2*(3.*b + ca) +
comp_41=`  t2*r*(c - db) +
comp_42=`  // t2*r*(3.*c - db) +
comp_43=`  t3*c;
comp_44=`}
comp_45=`
comp_46=`float randCubic(float2 uv_conv){
comp_47=`  float2 uf = floor(uv_conv);
comp_48=`  uv_conv = frac(uv_conv);
comp_49=`  float r[16];
comp_50=`  float ft = 1.;
comp_51=`
comp_52=`  float steps = 0.1013;
comp_53=`  float t = time*steps;
comp_54=`  ft = mod_conv(t,steps)/steps;
comp_55=`  ft = ft*ft*(3.-2.*ft);
comp_56=`  t = t - mod_conv(t,steps);
comp_57=`
comp_58=`  for(int i = 0; i < 16; i++){
comp_59=`    float r0 = rand(t + uf + float2(i%4,i/4));
comp_60=`    float r1 = rand((t + steps) + uf + float2(i%4,i/4));
comp_61=`    r[i] = lerp(r0, r1, ft);
comp_62=`  }
comp_63=`
comp_64=`  float4 g = cubicSpline(uv_conv.y,
comp_65=`  float4(r[0],r[1],r[2],r[3]),
comp_66=`  float4(r[4],r[5],r[6],r[7]),
comp_67=`  float4(r[8],r[9],r[10],r[11]),
comp_68=`  float4(r[12],r[13],r[14],r[15])
comp_69=`  );
comp_70=`  return cubicSpline(uv_conv.x, g.xxxx, g.yyyy, g.zzzz, g.wwww).x;
comp_71=`}
comp_72=`
comp_73=`shader_body {
comp_74=`  float4 fragColor = 0;
comp_75=`  // CONV: Center on screen, then try some aspect correction
comp_76=`  uv = (uv*2) - 1;
comp_77=`  uv *= aspect.xy;
comp_78=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_79=`  uv = float2(uv.x, -uv.y);
comp_80=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_81=`  uv += float2(0,0) + 0;
comp_82=`  uv *= float2(1,1) * 1.5;
comp_83=`
comp_84=`  // float2 uv = (2.*fragCoord.xy - uv.xy)/uv.y;
comp_85=`  float c = randCubic(uv*4.);
comp_86=`  fragColor = float4(lerp(float3(0.,.05,.3),float3(.5,.7,1),c),1);
comp_87=`  ret = fragColor;
comp_88=`}
