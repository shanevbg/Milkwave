warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// lennyjpg - cream / https://www.shadertoy.com/view/3lXGWM
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`/*
comp_7=`
comp_8=`// golfed version by FabriceNeyret2
comp_9=`#define mainImage(O,U)                           float2  u = U/uv_conv.x/.1;                \
comp_10=`
comp_11=`float y = u.y + .3*sin(2.53*u.x) + time,    x = 3.*u.x + time + 23.*floor(y);     \
comp_12=`y = frac(y);                          O += 1.5*( y - smoothstep( .45, .5, y / ( 1. - sin(x-cos(x)) *(.5 + .2*sin(x*.22)) - .1*sin(x*1.7) )))
comp_13=`
comp_14=`*/
comp_15=`shader_body {
comp_16=`  float4 O = 0;
comp_17=`  float2 U  = uv;
comp_18=`  // CONV: Center on screen, then try some aspect correction
comp_19=`  uv = (uv*2) - 1;
comp_20=`  uv *= aspect.xy;
comp_21=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y) and set viewpoint
comp_22=`  uv = float2(uv.x, -uv.y);
comp_23=`  uv += float2(0.0, 0.0);
comp_24=`  uv *= float2(0.5, 0.5);
comp_25=`
comp_26=`  float2 u = uv;
comp_27=`
comp_28=`  u.y += sin(u.x*25.3)*.03 + time*.1;
comp_29=`  u *= float2(30,10);
comp_30=`
comp_31=`  float x = u.x + time + floor(u.y) * 23.,
comp_32=`  y = frac(u.y),
comp_33=`  f = .5 + sin(x*.22)*.2,
comp_34=`  w = 1. - sin(x-cos(x))*f
comp_35=`  - sin(x*1.7)*.1,
comp_36=`  k = smoothstep(w*.9,w,y*2.);
comp_37=`
comp_38=`  O = float4( (y-k) *1.5 ,  (y-k) *1.5 ,  (y-k) *1.5 ,  (y-k) *1.5 );
comp_39=`  ret = O;
comp_40=`}
