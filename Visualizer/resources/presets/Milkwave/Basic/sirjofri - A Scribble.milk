b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// sirjofri - "A" Scribble / https://www.shadertoy.com/view/3t2cDc
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`shader_body {
comp_7=`  float4 fragColor = 0;
comp_8=`  float2 fragCoord  = uv;
comp_9=`  // CONV: Center on screen, then try some aspect correction
comp_10=`  uv = (uv*2) - 1;
comp_11=`  uv *= aspect.xy;
comp_12=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_13=`  uv = float2(uv.x, -uv.y);
comp_14=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_15=`  uv += float2(0,0) + 1;
comp_16=`  uv *= float2(1,2) * 0.5;
comp_17=`
comp_18=`  // float2 uv = fragCoord/uv.xy;
comp_19=`  uv -= .5;
comp_20=`  float f = pow((1.-length(uv)), 1.5);
comp_21=`  uv.x *= 25.;
comp_22=`  uv.y *= 0.7;
comp_23=`
comp_24=`  float2 d = float2(
comp_25=`  sin(time+uv.y*10.+uv.x*.3+2.*cos(time+uv.x*2.)),
comp_26=`  sin(time-uv.x-uv.y*30.-3.*sin(time-uv.y*30.))
comp_27=`  );
comp_28=`
comp_29=`  uv += d*0.005;
comp_30=`
comp_31=`  float a = sin(uv.y + time + cos(abs(uv.x) + uv.y*10.))*0.5+0.5;
comp_32=`  float b = cos(uv.y + time*5. + tan(abs(uv.x) + uv.y*10.));
comp_33=`  float c = cos(uv.y + time + sin(abs(uv.x) - uv.y*10.))*0.5+0.5;
comp_34=`
comp_35=`  float3 x = float3(1., 0., 0.) * a;
comp_36=`  float3 y = float3(0., 0., 1.) * c;
comp_37=`  float3 z = float3(0., 1., 0.) * b;
comp_38=`
comp_39=`  float3 r = lerp(x+y, float3(0., 1., 0.), b);
comp_40=`
comp_41=`  fragColor = float4(r*f, 1.0);
comp_42=`  ret = fragColor;
comp_43=`}
