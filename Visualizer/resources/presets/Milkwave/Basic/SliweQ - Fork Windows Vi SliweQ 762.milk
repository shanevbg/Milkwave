MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=3.000
fGammaAdj=2.000
fDecay=0.750
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=16
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.400
fWaveScale=1.000
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=0.90000
rot=0.00000
cx=0.500
cy=0.500
dx=0.04000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// SliweQ - Fork Windows Vi SliweQ 762 / https://www.shadertoy.com/view/33s3DN
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette( float t ) {
comp_7=`  float3 colors[6];
comp_8=`  colors[0] = float3(0.5, 0.971, 0.151);
comp_9=`  // #36ABD9
comp_10=`
comp_11=`  float mixFactor = 0.5 + 0.5 * sin(time * 0.5);
comp_12=`  return lerp(colors[0], colors[0], mixFactor);
comp_13=`}
comp_14=`
comp_15=`float3 backgroundGradient(float2 uv_conv) {
comp_16=`  float3 color1 = float3(0.1255, 0.5961, 0.5490);
comp_17=`  // #078C8C
comp_18=`  float3 color2 = float3(0.188, 0.549, 0.243);
comp_19=`  // #308C3E
comp_20=`  float mixFactor = 0.5 + 0.5 * sin(time * 0.3);
comp_21=`  return lerp(color1, color2, uv_conv.y * mixFactor);
comp_22=`}
comp_23=`
comp_24=`shader_body {
comp_25=`  float4 fragColor = 0;
comp_26=`  float2 fragCoord  = uv;
comp_27=`  // CONV: Center on screen, then try some aspect correction
comp_28=`  uv.x = (uv.x*2) - 1;
comp_29=`  uv.y = (uv.y*2)-1.8;
comp_30=`  uv *= aspect.xy;
comp_31=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_32=`  uv = float2(uv.x, -uv.y);
comp_33=`
comp_34=`  float wave = sin(time*2.);
comp_35=`  // float2 uv = fragCoord / uv.xy;
comp_36=`  float3 finalCol = backgroundGradient(uv);
comp_37=`
comp_38=`  for (float i = 0.0; i < 7.0; i++) {
comp_39=`    float d = uv.g;
comp_40=`    float w = uv.r;
comp_41=`
comp_42=`    d = sin(d - 0.3 * 0.1 * (wave/5.+5.)) + sin(uv.r * 2. + time/2.)/20. - sin(i)/10. + sin(uv.r * 4.3 + time*1.3 * i*0.2)/20.;
comp_43=`    d = abs(d/2.);
comp_44=`    d = 0.003/d /8. *i;
comp_45=`
comp_46=`    w += sin(uv.g*2. + time)/60.;
comp_47=`    w = abs(sin(w*20.*i/4. + time*sin(i))/20. + sin(w*10.*i)/17.)*30.;
comp_48=`    w += uv.g*2.4-1.6;
comp_49=`    w /= 3.;
comp_50=`    w = smoothstep(0.4, 0.7, w)/20.;
comp_51=`
comp_52=`    float3 col = palette(uv.r + time/3.);
comp_53=`    finalCol += col *= d + w;
comp_54=`  }
comp_55=`
comp_56=`  fragColor = float4(finalCol,1.0);
comp_57=`  ret = fragColor;
comp_58=`}
