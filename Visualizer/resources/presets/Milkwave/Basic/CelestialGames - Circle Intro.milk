warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// CelestialGames - Circle Intro / https://www.shadertoy.com/view/432GW1
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`float3 palette( float t ) {
comp_7=`  float3 a = float3(0.5, 0.5, 0.5);
comp_8=`  float3 b = float3(0.5, 0.5, 0.5);
comp_9=`  float3 c = float3(1.0, 1.0, 1.0);
comp_10=`  float3 d = float3(0.263,0.416,0.557);
comp_11=`
comp_12=`  return a + b*cos( 6.28318*(c*t+d) );
comp_13=`}
comp_14=`
comp_15=`float map(float value, float min1, float max1, float min2, float max2) {
comp_16=`  return min2 + (value - min1) * (max2 - min2) / (max1 - min1);
comp_17=`}
comp_18=`
comp_19=`shader_body {
comp_20=`  float4 fragColor = 0;
comp_21=`  float2 fragCoord  = uv;
comp_22=`  // CONV: Center on screen, then try some aspect correction
comp_23=`  uv = (uv*2) - 1;
comp_24=`  uv *= aspect.xy;
comp_25=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_26=`  uv = float2(uv.x, -uv.y);
comp_27=`  // CONV: Adjust viewpoint (x,y individually or both)
comp_28=`  uv += float2(0,0) + 0;
comp_29=`  uv *= float2(1,1) * 1;
comp_30=`
comp_31=`  // float2 uv = (fragCoord * 2.0 - uv.xy) / uv.y;
comp_32=`  float2 uv0 = uv;
comp_33=`  float3 finalColor = float3(0.0, 0.0, 0.0);
comp_34=`
comp_35=`  float speed = 0.5;
comp_36=`  float steps = 0.015;
comp_37=`
comp_38=`  for (float i = 0.0; i < 4.0; i++) {
comp_39=`    uv = frac(uv * sin(time*speed)) - 0.5;
comp_40=`
comp_41=`    float d = length(uv) * exp(-length(uv0));
comp_42=`
comp_43=`    float3 col = palette(length(uv0) + i*.4 + time*.4);
comp_44=`
comp_45=`    d = sin(d*8. + time)/8.;
comp_46=`    d = abs(d);
comp_47=`
comp_48=`    // d = pow(0.01 / d, 2.0);
comp_49=`    d = pow(step(steps, d), 2.0);
comp_50=`
comp_51=`    finalColor += col * d;
comp_52=`  }
comp_53=`
comp_54=`  fragColor = float4(finalColor, 1.0);
comp_55=`  ret = fragColor;
comp_56=`}
