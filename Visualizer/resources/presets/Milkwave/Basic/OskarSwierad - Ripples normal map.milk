mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`    ret *= 0.75; //or try: ret -= 0.004;
warp_8=`}
comp_1=`// OskarSwierad - Ripples normal map / https://www.shadertoy.com/view/3lGXzt
comp_2=`// Transpiled to HLSL using Milkwave
comp_3=`
comp_4=`#define tx (sin(time)*0.5+1)
comp_5=`
comp_6=`#define PI 3.14159265359
comp_7=`
comp_8=`float saturate(float x)
comp_9=`{
comp_10=`  return clamp(x, 0.0, 1.0);
comp_11=`}
comp_12=`
comp_13=`float RemapTo01(float val, float rangeMin, float rangeMax)
comp_14=`{
comp_15=`  return saturate((val - rangeMin) / (rangeMax - rangeMin));
comp_16=`}
comp_17=`
comp_18=`shader_body {
comp_19=`  float4 fragColor = 0;
comp_20=`  float2 fragCoord  = uv;
comp_21=`  // CONV: Center on screen, then try some aspect correction
comp_22=`  uv = (uv*2) - 0.5;
comp_23=`  uv *= aspect.xy;
comp_24=`  // CONV: Adjust this to flip the output (±uv.x, ±uv.y)
comp_25=`  uv = float2(uv.x, -uv.y);
comp_26=`  uv.y += 0.5;
comp_27=`  float2 aspectRatio = float2(1.0, uv.y / uv.x);
comp_28=`  float2 uvCentered = uv;
comp_29=`  uvCentered.x += -0.4;
comp_30=`  //uvCentered.y += 0;
comp_31=`  uvCentered *= 0.5;
comp_32=`  
comp_33=`  float2 pivot = float2(0.05, 0.1);
comp_34=`
comp_35=`  float radius = 0.5;
comp_36=`  float2 diff = (uvCentered - pivot) / radius;
comp_37=`  float dist = length(diff);
comp_38=`
comp_39=`  float mask = float(dist < 1.0);
comp_40=`
comp_41=`  // diff = smoothstep(float2(0.0, 0.0), float2(1.0), diff);
comp_42=`
comp_43=`  float waveFreq = 32.0;
comp_44=`  float speed = 3.0;
comp_45=`  float distForSin = length(diff);
comp_46=`  distForSin = pow(distForSin, 0.5);
comp_47=`  float height = sin(distForSin * waveFreq - (time * speed));
comp_48=`  // height *= 0.5;
comp_49=`  // height = (dist < 1.0) ? heightAdd : 0.0;
comp_50=`
comp_51=`  float2 dir = normalize(diff);
comp_52=`  // diff += dir * height * 0.9;
comp_53=`
comp_54=`  float3 norm = normalize(float3(
comp_55=`  diff.xy,
comp_56=`  sqrt( saturate( 1.0 - dot( diff.xy, diff.xy ) ) )
comp_57=`  ));
comp_58=`
comp_59=`  norm.xy += dir * height * 0.9;
comp_60=`  norm = normalize(norm);
comp_61=`
comp_62=`  // norm.z += heightAdd;
comp_63=`  // norm = normalize(norm);
comp_64=`
comp_65=`  float softEdgeMask = RemapTo01(dist, 1.0, 0.4);
comp_66=`  softEdgeMask = smoothstep(0.0, 1.0, softEdgeMask);
comp_67=`  if (softEdgeMask > 0.0)
comp_68=`  {
comp_69=`    norm.xy *= softEdgeMask;
comp_70=`  }
comp_71=`
comp_72=`  norm = normalize(norm);
comp_73=`
comp_74=`  float3 col = float3(0.5, 0.5, 0.5);
comp_75=`  col = float3(uvCentered, 0.0);
comp_76=`  // col = float3(dist);
comp_77=`
comp_78=`  if (mask < 1.0)
comp_79=`  {
comp_80=`    norm = float3(0,0,1);
comp_81=`  }
comp_82=`
comp_83=`  col = float3(norm);
comp_84=`
comp_85=`  col = col * 0.5 + float3(0.5, 0.5, 0.5);
comp_86=`  // col = float3(heightAdd);
comp_87=`
comp_88=`  fragColor = float4(col,1.0);
comp_89=`  ret = fragColor;
comp_90=`}
